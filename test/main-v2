// UI: Scene Tree (left)
// =============================================================

function renderSceneTree(): void {
	if (!state.scene) return;

	if (ImGui.Button("+ Add##tree")) {
		addShapeObject("rectangle");
	}
	ImGui.SameLine();
	if (ImGui.Button("Clear Sel")) {
		state.selectedIds = [];
		state.primaryId = null;
	}
	ImGui.SameLine();
	ImGui.TextDisabled(`${state.scene.objects.length} obj`);

	ImGui.Separator();

	ImGui.BeginChild("##tree_scroll", new ImVec2(0, 0), ImGuiChildFlags.None);

	// group by layer
	for (const layer of state.scene.layers) {
		const layerObjs = state.scene.objects.filter((o) => o.layerId === layer.id).sort((a, b) => b.zIndex - a.zIndex);

		const flags = ImGuiTreeNodeFlags.SpanAvailWidth | ImGuiTreeNodeFlags.DefaultOpen;
		const label = `${layer.visible ? "[V]" : "[ ]"} ${layer.name} (${layerObjs.length})`;
		if (ImGui.TreeNodeEx(`${label}##${layer.id}`, flags)) {
			for (const obj of layerObjs) {
				const sel = state.selectedIds.includes(obj.id);
				const objFlags = ImGuiSelectableFlags.AllowDoubleClick | ImGuiSelectableFlags.SpanAllColumns;
				const label2 = `${obj.name}  #${obj.zIndex}`;

				if (ImGui.Selectable(`${label2}##${obj.id}`, sel, objFlags)) {
					state.selectedIds = [obj.id];
					state.primaryId = obj.id;
				}

				// drag & drop for reparenting within tree
				if (ImGui.BeginDragDropSource()) {
					ImGui.SetDragDropPayload("TREE_OBJ", obj.id, obj.id.length, 0);
					ImGui.Text(obj.name);
					ImGui.EndDragDropSource();
				}
				if (ImGui.BeginDragDropTarget()) {
					const payload = ImGui.AcceptDragDropPayload("TREE_OBJ");
					if (payload && payload.IsDelivery()) {
						// reorder z or move layer — for simplicity swap zIndex
						const srcId = payload.Data;
						const src = findObject(srcId);
						if (src && src.id !== obj.id) {
							src.layerId = obj.layerId;
							src.zIndex = obj.zIndex + 1;
							log(`Moved ${src.name} to layer ${obj.layerId}`);
							snapshot();
						}
					}
					ImGui.EndDragDropTarget();
				}

				// context menu
				if (ImGui.BeginPopupContextItem(`ctx_obj_${obj.id}`)) {
					if (ImGui.MenuItem("Rename")) {
						// handled via inspector
					}
					if (ImGui.MenuItem("Duplicate")) {
						state.selectedIds = [obj.id];
						duplicateSelected();
					}
					if (ImGui.MenuItem("Delete")) {
						state.selectedIds = [obj.id];
						deleteSelected();
					}
					if (ImGui.MenuItem("Focus")) {
						state.camera.x = obj.transform.x;
						state.camera.y = obj.transform.y;
					}
					ImGui.EndPopup();
				}
			}
			ImGui.TreePop();
		}
	}

	ImGui.EndChild();
}

