function addShapeObject(shape: VisualShape): void {
	if (!state.scene) return;
	const obj = createShapeObject(shape, state.camera.x, state.camera.y);
	state.scene.objects.push(obj);
	state.selectedIds = [obj.id];
	state.primaryId = obj.id;
	snapshot();
	log(`Added ${shape}`);
}

function addTextObject(): void {
	if (!state.scene) return;
	const obj = createTextObject(state.camera.x, state.camera.y);
	state.scene.objects.push(obj);
	state.selectedIds = [obj.id];
	state.primaryId = obj.id;
	snapshot();
	log("Added text");
}

function pickTexture(): void {
	const input = document.createElement("input");
	input.type = "file";
	input.accept = "image/*";
	input.onchange = async () => {
		const file = input.files?.[0];
		if (!file) return;
		await loadTextureFromFile(file);
		// Create sprite at camera
		if (state.scene) {
			const obj = createSpriteObject(file.name, state.camera.x, state.camera.y);
			state.scene.objects.push(obj);
			state.selectedIds = [obj.id];
			state.primaryId = obj.id;
			snapshot();
		}
	};
	input.click();
}

