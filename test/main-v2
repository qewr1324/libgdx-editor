function renderLayersPanel(): void {
	if (!state.scene) return;

	if (ImGui.Button("+ Layer", new ImVec2(-1, 0))) {
		const id = makeId("layer");
		state.scene.layers.push({
			id,
			name: `Layer ${state.scene.layers.length + 1}`,
			visible: true,
			locked: false,
		});
		state.activeLayerId = id;
		snapshot();
	}

	ImGui.Separator();

	for (let i = 0; i < state.scene.layers.length; i++) {
		const layer = state.scene.layers[i];
		const isActive = state.activeLayerId === layer.id;

		ImGui.PushID(layer.id);

		// visibility toggle
		if (ImGui.SmallButton(layer.visible ? "V" : "-")) {
			layer.visible = !layer.visible;
		}
		ImGui.SameLine();
		// lock toggle
		if (ImGui.SmallButton(layer.locked ? "L" : " ")) {
			layer.locked = !layer.locked;
		}
		ImGui.SameLine();

		// name (selectable)
		if (ImGui.Selectable(`${layer.name}##${layer.id}`, isActive, ImGuiSelectableFlags.SpanAllColumns)) {
			state.activeLayerId = layer.id;
		}

		// context menu
		if (ImGui.BeginPopupContextItem(`layer_ctx_${layer.id}`)) {
			let nameArr = [layer.name];
			if (ImGui.InputText("Name", nameArr, 128)) layer.name = nameArr[0];
			if (ImGui.MenuItem("Delete")) {
				if (state.scene.layers.length > 1) {
					state.scene.layers.splice(i, 1);
					// reassign objects
					for (const o of state.scene.objects) {
						if (o.layerId === layer.id) o.layerId = state.scene.layers[0].id;
					}
					snapshot();
				}
			}
			if (ImGui.MenuItem("Move Up") && i > 0) {
				[state.scene.layers[i - 1], state.scene.layers[i]] = [state.scene.layers[i], state.scene.layers[i - 1]];
				snapshot();
			}
			if (ImGui.MenuItem("Move Down") && i < state.scene.layers.length - 1) {
				[state.scene.layers[i + 1], state.scene.layers[i]] = [state.scene.layers[i], state.scene.layers[i + 1]];
				snapshot();
			}
			ImGui.EndPopup();
		}

		ImGui.PopID();
	}
}

