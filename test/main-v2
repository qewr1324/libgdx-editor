// =============================================================
// Actions
// =============================================================

function newScene(): void {
	state.scene = {
		name: "Untitled",
		worldSize: { width: 1920, height: 1080 },
		backgroundColor: col(0xff1a1a1a),
		gridSize: 32,
		snapToGrid: false,
		snapToObjects: true,
		showGrid: true,
		showWorldBorder: true,
		showRulers: true,
		layers: [{ id: "layer_default", name: "Default", visible: true, locked: false }],
		objects: [],
	};
	state.camera = { x: 960, y: 540, zoom: 0.6 };
	state.selectedIds = [];
	state.primaryId = null;
	state.activeLayerId = "layer_default";
	state.history = [];
	state.historyIndex = -1;
	snapshot();
	log("New scene");
}

function resetView(): void {
	if (!state.scene) return;
	state.camera = {
		x: state.scene.worldSize.width / 2,
		y: state.scene.worldSize.height / 2,
		zoom: 0.6,
	};
}

function duplicateSelected(): void {
	if (!state.scene || state.selectedIds.length === 0) return;
	const newIds: string[] = [];
	for (const id of state.selectedIds) {
		const obj = findObject(id);
		if (!obj) continue;
		const copy: SceneObject = JSON.parse(JSON.stringify(obj));
		copy.id = makeId();
		copy.name = obj.name + "_copy";
		copy.transform.x += 20;
		copy.transform.y += 20;
		copy.zIndex = state.scene.objects.length;
		state.scene.objects.push(copy);
		newIds.push(copy.id);
	}
	state.selectedIds = newIds;
	state.primaryId = newIds[newIds.length - 1] ?? null;
	snapshot();
	log(`Duplicated ${newIds.length} object(s)`);
}

function deleteSelected(): void {
	if (!state.scene || state.selectedIds.length === 0) return;
	state.scene.objects = state.scene.objects.filter((o) => !state.selectedIds.includes(o.id));
	const n = state.selectedIds.length;
	state.selectedIds = [];
	state.primaryId = null;
	snapshot();
	log(`Deleted ${n} object(s)`);
}

function selectAll(): void {
	if (!state.scene) return;
	state.selectedIds = state.scene.objects.map((o) => o.id);
	state.primaryId = state.selectedIds[state.selectedIds.length - 1] ?? null;
}

function saveJSON(): void {
	if (!state.scene) return;
	const json = JSON.stringify(state.scene, null, 2);
	const blob = new Blob([json], { type: "application/json" });
	const url = URL.createObjectURL(blob);
	const a = document.createElement("a");
	a.href = url;
	a.download = `${state.scene.name || "scene"}.json`;
	a.click();
	URL.revokeObjectURL(url);
	log("Saved JSON");
}

function loadJSON(): void {
	const input = document.createElement("input");
	input.type = "file";
	input.accept = "application/json";
	input.onchange = async () => {
		const file = input.files?.[0];
		if (!file) return;
		try {
			state.scene = JSON.parse(await file.text());
			state.selectedIds = [];
			state.primaryId = null;
			state.history = [];
			state.historyIndex = -1;
			snapshot();
			log(`Loaded ${file.name}`);
		} catch (e) {
			log(`Load failed: ${e}`);
		}
	};
	input.click();
}

function exportPNG(): void {
	const canvas = document.getElementById("canvas") as HTMLCanvasElement;
	canvas.toBlob((blob) => {
		if (!blob) return;
		const url = URL.createObjectURL(blob);
		const a = document.createElement("a");
		a.href = url;
		a.download = `${state.scene?.name ?? "scene"}.png`;
		a.click();
		URL.revokeObjectURL(url);
		log("Exported PNG");
	});
}

