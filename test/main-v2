/**
 * Scene Viewport — ImGui + WebGL2
 * Full editor: Docking, Scene Tree, Inspector, Components, Layers, Marquee,
 * Sprite/Texture, Atlas, Snapping, Export.
 */

import { ImGui, ImGuiImplWeb, ImVec2, ImVec4, ImTextureRef, ImGuiWindowFlags, ImGuiChildFlags, ImGuiCol, ImGuiStyleVar, ImGuiMouseButton, ImGuiMouseCursor, ImGuiKey, ImGuiCond, ImGuiTableFlags, ImGuiSelectableFlags, ImGuiTreeNodeFlags, ImGuiInputTextFlags } from "@mori2003/jsimgui";

// =============================================================
// Types
// =============================================================

type VisualShape = "rectangle" | "circle" | "triangle" | "diamond" | "pentagon" | "hexagon" | "star";

interface Transform {
	x: number;
	y: number;
	width: number;
	height: number;
	rotation: number;
	originX: number;
	originY: number;
	scaleX: number;
	scaleY: number;
}

// ---- Components ----
interface SpriteComponent {
	id: string;
	type: "sprite";
	texturePath: string; // "" if none
	tint: number;
	flipX: boolean;
	flipY: boolean;
}

interface ShapeComponent {
	id: string;
	type: "shape";
	shape: VisualShape;
	color: number;
	filled: boolean;
	strokeWidth: number;
}

interface TextComponent {
	id: string;
	type: "text";
	text: string;
	color: number;
	fontSize: number;
}

interface PhysicsComponent {
	id: string;
	type: "physics";
	bodyType: "dynamic" | "static" | "kinematic";
	mass: number;
	gravityScale: number;
	velocityX: number;
	velocityY: number;
	fixedRotation: boolean;
}

interface ColliderComponent {
	id: string;
	type: "collider";
	shape: "box" | "circle";
	isTrigger: boolean;
	friction: number;
	restitution: number;
}

interface TagComponent {
	id: string;
	type: "tag";
	tags: string[];
}

type Component = SpriteComponent | ShapeComponent | TextComponent | PhysicsComponent | ColliderComponent | TagComponent;

interface SceneObject {
	id: string;
	name: string;
	layerId: string;
	zIndex: number;
	transform: Transform;
	components: Component[];
}

interface Layer {
	id: string;
	name: string;
	visible: boolean;
	locked: boolean;
}

interface Scene {
	name: string;
	worldSize: { width: number; height: number };
	backgroundColor: number;
	gridSize: number;
	snapToGrid: boolean;
	snapToObjects: boolean;
	showGrid: boolean;
	showWorldBorder: boolean;
	showRulers: boolean;
	layers: Layer[];
	objects: SceneObject[];
}

// ---- Textures ----
interface LoadedTexture {
	path: string;
	ref: ImTextureRef;
	width: number;
	height: number;
	image: HTMLImageElement;
}

// ---- Interaction ----
type InteractionMode = "idle" | "drag" | "resize" | "rotate" | "pan" | "marquee";
type HandleType = "nw" | "n" | "ne" | "e" | "se" | "s" | "sw" | "w";

interface InteractionData {
	mode: InteractionMode;
	startWorldX: number;
	startWorldY: number;
	startScreenX: number;
	startScreenY: number;
	startTransforms: Map<string, Transform>;
	primaryId: string;
	handle?: HandleType;
	rotateCenter?: { x: number; y: number };
	rotateStartAngle?: number;
	rotateStartRotation?: number;
	panStartX?: number;
	panStartY?: number;
	marqueeRect?: { x: number; y: number; w: number; h: number };
}

// =============================================================
// Utility
// =============================================================

function rgba(r: number, g: number, b: number, a = 255): number {
	return (((a & 0xff) << 24) | ((b & 0xff) << 16) | ((g & 0xff) << 8) | (r & 0xff)) >>> 0;
}

function col(hex: number): number {
	return hex >>> 0;
}

function hexToU32(hex: string): number {
	const h = hex.replace("#", "");
	const r = parseInt(h.substring(0, 2), 16);
	const g = parseInt(h.substring(2, 4), 16);
	const b = parseInt(h.substring(4, 6), 16);
	const a = h.length === 8 ? parseInt(h.substring(6, 8), 16) : 255;
	return rgba(r, g, b, a);
}

function u32ToHex(u: number): string {
	const a = (u >>> 24) & 0xff;
	const b = (u >>> 16) & 0xff;
	const g = (u >>> 8) & 0xff;
	const r = u & 0xff;
	const hex2 = (n: number) => n.toString(16).padStart(2, "0");
	return a === 255 ? `#${hex2(r)}${hex2(g)}${hex2(b)}` : `#${hex2(r)}${hex2(g)}${hex2(b)}${hex2(a)}`;
}

function makeId(prefix = "obj"): string {
	return `${prefix}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 7)}`;
}

function round(n: number): number {
	return Math.round(n);
}

function clamp(v: number, min: number, max: number): number {
	return Math.max(min, Math.min(max, v));
}

// =============================================================
// Global state
// =============================================================

const state = {
	scene: null as Scene | null,
	selectedIds: [] as string[],
	primaryId: null as string | null,
	interaction: null as InteractionData | null,
	camera: { x: 0, y: 0, zoom: 1 },
	history: [] as string[],
	historyIndex: -1,
	snapGuides: [] as Array<{ x1: number; y1: number; x2: number; y2: number }>,
	contextMenu: {
		open: false,
		x: 0,
		y: 0,
		worldX: 0,
		worldY: 0,
	},
	textures: new Map<string, LoadedTexture>(),
	activeLayerId: null as string | null,
	showDemo: false,
	showConsole: true,
	consoleLines: [] as string[],
	marquee: null as { x1: number; y1: number; x2: number; y2: number } | null,
};

function log(msg: string): void {
	const t = new Date().toLocaleTimeString();
	state.consoleLines.push(`[${t}] ${msg}`);
	if (state.consoleLines.length > 200) state.consoleLines.shift();
}

// =============================================================
// Camera <-> World
// =============================================================

function worldToScreen(wx: number, wy: number, originX: number, originY: number) {
	return {
		x: originX + (wx - state.camera.x) * state.camera.zoom,
		y: originY + (wy - state.camera.y) * state.camera.zoom,
	};
}

function screenToWorld(sx: number, sy: number, originX: number, originY: number) {
	return {
		x: (sx - originX) / state.camera.zoom + state.camera.x,
		y: (sy - originY) / state.camera.zoom + state.camera.y,
	};
}

// =============================================================
// Component helpers
// =============================================================

function getComponent<T extends Component["type"]>(obj: SceneObject, type: T): Extract<Component, { type: T }> | null {
	return (obj.components.find((c) => c.type === type) as any) ?? null;
}

function addComponent(obj: SceneObject, comp: Component): void {
	obj.components.push(comp);
}

function removeComponent(obj: SceneObject, compId: string): void {
	obj.components = obj.components.filter((c) => c.id !== compId);
}

function getObjectBounds(obj: SceneObject): { x1: number; y1: number; x2: number; y2: number } {
	const t = obj.transform;
	const hw = t.width * t.originX;
	const hh = t.height * t.originY;
	return { x1: t.x - hw, y1: t.y - hh, x2: t.x + t.width - hw, y2: t.y + t.height - hh };
}

// =============================================================
// Object creation
// =============================================================

function createObject(x: number, y: number): SceneObject {
	const id = makeId();
	return {
		id,
		name: `object_${id.slice(-4)}`,
		layerId: state.activeLayerId ?? state.scene?.layers[0]?.id ?? "layer_default",
		zIndex: state.scene?.objects.length ?? 0,
		transform: {
			x,
			y,
			width: 100,
			height: 80,
			rotation: 0,
			originX: 0.5,
			originY: 0.5,
			scaleX: 1,
			scaleY: 1,
		},
		components: [],
	};
}

function createShapeObject(shape: VisualShape, x: number, y: number): SceneObject {
	const obj = createObject(x, y);
	obj.name = `${shape}_${obj.id.slice(-4)}`;
	const palette: Record<VisualShape, number> = {
		rectangle: rgba(74, 158, 255),
		circle: rgba(74, 255, 158),
		triangle: rgba(255, 170, 74),
		diamond: rgba(74, 255, 255),
		pentagon: rgba(170, 74, 255),
		hexagon: rgba(255, 255, 74),
		star: rgba(255, 74, 255),
	};
	addComponent(obj, {
		id: makeId("comp"),
		type: "shape",
		shape,
		color: palette[shape],
		filled: true,
		strokeWidth: 2,
	});
	return obj;
}

function createTextObject(x: number, y: number): SceneObject {
	const obj = createObject(x, y);
	obj.name = `text_${obj.id.slice(-4)}`;
	obj.transform.width = 160;
	obj.transform.height = 40;
	addComponent(obj, {
		id: makeId("comp"),
		type: "text",
		text: "Hello World",
		color: rgba(255, 255, 255),
		fontSize: 18,
	});
	return obj;
}

function createSpriteObject(texturePath: string, x: number, y: number): SceneObject {
	const obj = createObject(x, y);
	obj.name = `sprite_${obj.id.slice(-4)}`;
	const tex = state.textures.get(texturePath);
	if (tex) {
		obj.transform.width = tex.width;
		obj.transform.height = tex.height;
	} else {
		obj.transform.width = 128;
		obj.transform.height = 128;
	}
	addComponent(obj, {
		id: makeId("comp"),
		type: "sprite",
		texturePath,
		tint: rgba(255, 255, 255),
		flipX: false,
		flipY: false,
	});
	return obj;
}

function findObject(id: string): SceneObject | null {
	return state.scene?.objects.find((o) => o.id === id) ?? null;
}

function findLayer(id: string): Layer | null {
	return state.scene?.layers.find((l) => l.id === id) ?? null;
}

// =============================================================
// History
// =============================================================

function snapshot(): void {
	if (!state.scene) return;
	const json = JSON.stringify(state.scene);
	if (state.historyIndex >= 0 && state.history[state.historyIndex] === json) return;
	state.history = state.history.slice(0, state.historyIndex + 1);
	state.history.push(json);
	state.historyIndex = state.history.length - 1;
	if (state.history.length > 100) {
		state.history.shift();
		state.historyIndex--;
	}
}

function undo(): void {
	if (state.historyIndex <= 0) return;
	state.historyIndex--;
	state.scene = JSON.parse(state.history[state.historyIndex]);
	log("Undo");
}

function redo(): void {
	if (state.historyIndex >= state.history.length - 1) return;
	state.historyIndex++;
	state.scene = JSON.parse(state.history[state.historyIndex]);
	log("Redo");
}

// =============================================================
// Snapping
// =============================================================

function computeSnap(proposedX: number, proposedY: number, primary: SceneObject, excludeIds: Set<string>, threshold: number) {
	if (!state.scene) return { x: proposedX, y: proposedY, guides: [] };

	const guides: Array<{ x1: number; y1: number; x2: number; y2: number }> = [];
	const t = primary.transform;

	const mLeft = proposedX - t.width * t.originX;
	const mRight = mLeft + t.width;
	const mTop = proposedY - t.height * t.originY;
	const mBottom = mTop + t.height;
	const mCenterX = proposedX;
	const mCenterY = proposedY;

	let bestX: any = null;
	let bestY: any = null;

	const considerX = (mVal: number, oVal: number, refMin: number, refMax: number) => {
		const delta = oVal - mVal;
		if (Math.abs(delta) <= threshold && (!bestX || Math.abs(delta) < Math.abs(bestX.delta))) {
			bestX = { delta, snapX: oVal, ref: { min: refMin, max: refMax } };
		}
	};
	const considerY = (mVal: number, oVal: number, refMin: number, refMax: number) => {
		const delta = oVal - mVal;
		if (Math.abs(delta) <= threshold && (!bestY || Math.abs(delta) < Math.abs(bestY.delta))) {
			bestY = { delta, snapY: oVal, ref: { min: refMin, max: refMax } };
		}
	};

	if (state.scene.snapToObjects) {
		const W = state.scene.worldSize.width;
		const H = state.scene.worldSize.height;
		considerX(mLeft, 0, mTop, mBottom);
		considerX(mRight, W, mTop, mBottom);
		considerX(mCenterX, W / 2, mTop, mBottom);
		considerY(mTop, 0, mLeft, mRight);
		considerY(mBottom, H, mLeft, mRight);
		considerY(mCenterY, H / 2, mLeft, mRight);

		for (const obj of state.scene.objects) {
			if (excludeIds.has(obj.id)) continue;
			const b = getObjectBounds(obj);
			considerX(mLeft, b.x1, Math.min(b.y1, mTop), Math.max(b.y2, mBottom));
			considerX(mRight, b.x2, Math.min(b.y1, mTop), Math.max(b.y2, mBottom));
			considerX(mCenterX, (b.x1 + b.x2) / 2, Math.min(b.y1, mTop), Math.max(b.y2, mBottom));
			considerY(mTop, b.y1, Math.min(b.x1, mLeft), Math.max(b.x2, mRight));
			considerY(mBottom, b.y2, Math.min(b.x1, mLeft), Math.max(b.x2, mRight));
			considerY(mCenterY, (b.y1 + b.y2) / 2, Math.min(b.x1, mLeft), Math.max(b.x2, mRight));
		}
	}

	const finalX = bestX ? proposedX + bestX.delta : proposedX;
	const finalY = bestY ? proposedY + bestY.delta : proposedY;

	if (bestX) guides.push({ x1: bestX.snapX, y1: bestX.ref.min - 20, x2: bestX.snapX, y2: bestX.ref.max + 20 });
	if (bestY) guides.push({ x1: bestY.ref.min - 20, y1: bestY.snapY, x2: bestY.ref.max + 20, y2: bestY.snapY });

	return { x: finalX, y: finalY, guides };
}

// =============================================================
// Textures
// =============================================================

async function loadTextureFromFile(file: File): Promise<void> {
	const url = URL.createObjectURL(file);
	const img = new Image();
	img.src = url;
	await new Promise<void>((res, rej) => {
		img.onload = () => res();
		img.onerror = () => rej(new Error("load failed"));
	});

	// Register with ImGui/backend
	const gl = (document.getElementById("canvas") as HTMLCanvasElement).getContext("webgl2") as WebGL2RenderingContext;
	const tex = gl.createTexture()!;
	gl.bindTexture(gl.TEXTURE_2D, tex);
	gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
	gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
	gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
	gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
	gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);

	const ref = ImGuiImplWeb.RegisterTexture(tex);
	const path = file.name;
	state.textures.set(path, {
		path,
		ref,
		width: img.width,
		height: img.height,
		image: img,
	});
	log(`Loaded texture: ${path} (${img.width}x${img.height})`);
}

// =============================================================
// Rendering — draw list helpers
// =============================================================

interface ViewportRect {
	x: number;
	y: number;
	w: number;
	h: number;
	originX: number;
	originY: number;
}

function drawGrid(draw: any, vp: ViewportRect): void {
	if (!state.scene || !state.scene.showGrid) return;

	const gs = state.scene.gridSize;
	const zoom = state.camera.zoom;
	const wMin = screenToWorld(0, 0, vp.originX, vp.originY);
	const wMax = screenToWorld(vp.w, vp.h, vp.originX, vp.originY);

	const startX = Math.floor(wMin.x / gs) * gs;
	const startY = Math.floor(wMin.y / gs) * gs;
	const endX = Math.ceil(wMax.x / gs) * gs;
	const endY = Math.ceil(wMax.y / gs) * gs;

	let major = gs;
	while (major * zoom < 40) major *= 2;

	const gridColor = col(0x30ffffff);
	const majorColor = col(0x50ffffff);

	for (let x = startX; x <= endX; x += gs) {
		const isMajor = Math.abs(x % major) < 0.001;
		const sp = worldToScreen(x, 0, vp.originX, vp.originY);
		if (sp.x < vp.x || sp.x > vp.x + vp.w) continue;
		draw.AddLine(new ImVec2(sp.x, vp.y), new ImVec2(sp.x, vp.y + vp.h), isMajor ? majorColor : gridColor, 1.0);
	}
	for (let y = startY; y <= endY; y += gs) {
		const isMajor = Math.abs(y % major) < 0.001;
		const sp = worldToScreen(0, y, vp.originX, vp.originY);
		if (sp.y < vp.y || sp.y > vp.y + vp.h) continue;
		draw.AddLine(new ImVec2(vp.x, sp.y), new ImVec2(vp.x + vp.w, sp.y), isMajor ? majorColor : gridColor, 1.0);
	}
}

function drawWorldBorder(draw: any, vp: ViewportRect): void {
	if (!state.scene || !state.scene.showWorldBorder) return;
	const tl = worldToScreen(0, 0, vp.originX, vp.originY);
	const br = worldToScreen(state.scene.worldSize.width, state.scene.worldSize.height, vp.originX, vp.originY);
	draw.AddRect(new ImVec2(tl.x, tl.y), new ImVec2(br.x, br.y), rgba(74, 168, 255), 0, 2.0, 0);
}

function drawRulers(draw: any, vp: ViewportRect): void {
	if (!state.scene || !state.scene.showRulers) return;

	const rulerH = 22;
	const rulerW = 22;
	const bgTop = col(0xff252525);
	const bgCorner = col(0xff202020);
	const borderCol = col(0xff404040);
	const tickCol = col(0xff707070);
	const textColor = col(0xffb0b0b0);

	draw.AddRectFilled(new ImVec2(vp.x, vp.y - rulerH), new ImVec2(vp.x + vp.w, vp.y), bgTop);
	draw.AddLine(new ImVec2(vp.x, vp.y), new ImVec2(vp.x + vp.w, vp.y), borderCol, 1.0);
	draw.AddRectFilled(new ImVec2(vp.x - rulerW, vp.y), new ImVec2(vp.x, vp.y + vp.h), bgTop);
	draw.AddLine(new ImVec2(vp.x, vp.y), new ImVec2(vp.x, vp.y + vp.h), borderCol, 1.0);
	draw.AddRectFilled(new ImVec2(vp.x - rulerW, vp.y - rulerH), new ImVec2(vp.x, vp.y), bgCorner);

	const zoom = state.camera.zoom;
	let step = 100;
	while (step * zoom < 60) step *= 2;
	while (step * zoom > 200) step /= 2;

	const wMin = screenToWorld(vp.x, 0, vp.originX, vp.originY);
	const wMax = screenToWorld(vp.x + vp.w, 0, vp.originX, vp.originY);
	const startX = Math.floor(wMin.x / step) * step;
	for (let wx = startX; wx <= wMax.x; wx += step) {
		const sp = worldToScreen(wx, 0, vp.originX, vp.originY);
		if (sp.x < vp.x || sp.x > vp.x + vp.w) continue;
		draw.AddLine(new ImVec2(sp.x, vp.y - 8), new ImVec2(sp.x, vp.y), tickCol, 1.0);
		draw.AddText(new ImVec2(sp.x + 3, vp.y - rulerH + 4), textColor, String(wx));
	}

	const hMin = screenToWorld(0, vp.y, vp.originX, vp.originY);
	const hMax = screenToWorld(0, vp.y + vp.h, vp.originX, vp.originY);
	const startY = Math.floor(hMin.y / step) * step;
	for (let wy = startY; wy <= hMax.y; wy += step) {
		const sp = worldToScreen(0, wy, vp.originX, vp.originY);
		if (sp.y < vp.y || sp.y > vp.y + vp.h) continue;
		draw.AddLine(new ImVec2(vp.x - 8, sp.y), new ImVec2(vp.x, sp.y), tickCol, 1.0);
		draw.AddText(new ImVec2(vp.x - rulerW + 2, sp.y + 3), textColor, String(wy));
	}
}

function getObjectCorners(obj: SceneObject, vp: ViewportRect) {
	const t = obj.transform;
	const angle = (t.rotation * Math.PI) / 180;
	const cos = Math.cos(angle);
	const sin = Math.sin(angle);
	const halfW = t.width / 2;
	const halfH = t.height / 2;
	const local: Array<[number, number]> = [
		[-halfW, -halfH],
		[halfW, -halfH],
		[halfW, halfH],
		[-halfW, halfH],
	];
	return local.map(([lx, ly]) => {
		const rx = lx * cos - ly * sin;
		const ry = lx * sin + ly * cos;
		return worldToScreen(t.x + rx, t.y + ry, vp.originX, vp.originY);
	});
}

function drawShapePrimitive(draw: any, shape: VisualShape, corners: any[], center: any, t: Transform, zoom: number, fillCol: number, strokeCol: number, strokeW: number, filled: boolean): void {
	const w = t.width * zoom;
	const h = t.height * zoom;

	switch (shape) {
		case "rectangle": {
			if (filled) {
				draw.AddQuadFilled(new ImVec2(corners[0].x, corners[0].y), new ImVec2(corners[1].x, corners[1].y), new ImVec2(corners[2].x, corners[2].y), new ImVec2(corners[3].x, corners[3].y), fillCol);
			}
			for (let i = 0; i < 4; i++) {
				const a = corners[i];
				const b = corners[(i + 1) % 4];
				draw.AddLine(new ImVec2(a.x, a.y), new ImVec2(b.x, b.y), strokeCol, strokeW);
			}
			break;
		}
		case "circle": {
			const r = Math.min(w, h) / 2;
			if (filled) draw.AddCircleFilled(new ImVec2(center.x, center.y), r, fillCol, 0);
			draw.AddCircle(new ImVec2(center.x, center.y), r, strokeCol, 0, strokeW);
			break;
		}
		case "triangle": {
			const p1 = corners[0],
				p2 = corners[1],
				p3 = corners[3];
			if (filled) draw.AddTriangleFilled(new ImVec2(p1.x, p1.y), new ImVec2(p2.x, p2.y), new ImVec2(p3.x, p3.y), fillCol);
			draw.AddTriangle(new ImVec2(p1.x, p1.y), new ImVec2(p2.x, p2.y), new ImVec2(p3.x, p3.y), strokeCol, strokeW);
			break;
		}
		case "diamond": {
			const halfW = (t.width * zoom) / 2;
			const halfH = (t.height * zoom) / 2;
			const cx = center.x,
				cy = center.y;
			const pts = [new ImVec2(cx, cy - halfH), new ImVec2(cx + halfW, cy), new ImVec2(cx, cy + halfH), new ImVec2(cx - halfW, cy)];
			if (filled) draw.AddQuadFilled(pts[0], pts[1], pts[2], pts[3], fillCol);
			draw.AddQuad(pts[0], pts[1], pts[2], pts[3], strokeCol, strokeW);
			break;
		}
		case "pentagon":
		case "hexagon": {
			const sides = shape === "pentagon" ? 5 : 6;
			const r = Math.min(w, h) / 2;
			const pts: any[] = [];
			for (let i = 0; i < sides; i++) {
				const a = -Math.PI / 2 + (i * 2 * Math.PI) / sides;
				pts.push(new ImVec2(center.x + Math.cos(a) * r, center.y + Math.sin(a) * r));
			}
			if (filled) draw.AddConvexPolyFilled(pts, pts.length, fillCol);
			for (let i = 0; i < pts.length; i++) {
				draw.AddLine(pts[i], pts[(i + 1) % pts.length], strokeCol, strokeW);
			}
			break;
		}
		case "star": {
			const r = Math.min(w, h) / 2;
			const innerR = r * 0.45;
			const points = 5;
			const cx = center.x,
				cy = center.y;
			for (let i = 0; i < points * 2; i++) {
				const rr = i % 2 === 0 ? r : innerR;
				const a = -Math.PI / 2 + (i * Math.PI) / points;
				const x1 = cx + Math.cos(a) * rr;
				const y1 = cy + Math.sin(a) * rr;
				const a2 = -Math.PI / 2 + ((i + 1) * Math.PI) / points;
				const rr2 = (i + 1) % 2 === 0 ? r : innerR;
				const x2 = cx + Math.cos(a2) * rr2;
				const y2 = cy + Math.sin(a2) * rr2;
				draw.AddLine(new ImVec2(x1, y1), new ImVec2(x2, y2), strokeCol, strokeW);
			}
			break;
		}
	}
}

function drawObject(draw: any, obj: SceneObject, vp: ViewportRect): void {
	const t = obj.transform;
	const zoom = state.camera.zoom;
	const center = worldToScreen(t.x, t.y, vp.originX, vp.originY);
	const corners = getObjectCorners(obj, vp);

	for (const comp of obj.components) {
		if (comp.type === "shape") {
			const filledCol = comp.filled ? ((comp.color & 0x00ffffff) | 0x60000000) >>> 0 : 0;
			drawShapePrimitive(draw, comp.shape, corners, center, t, zoom, filledCol, comp.color, comp.strokeWidth, comp.filled);
		} else if (comp.type === "text") {
			const txt = comp.text ?? "";
			const txtW = ImGui.CalcTextSize(txt).x;
			draw.AddText(new ImVec2(center.x - txtW / 2, center.y - comp.fontSize / 2), comp.color, txt);
		} else if (comp.type === "sprite") {
			const tex = state.textures.get(comp.texturePath);
			if (tex) {
				const w = t.width * zoom;
				const h = t.height * zoom;
				const p1 = new ImVec2(center.x - w / 2, center.y - h / 2);
				const p2 = new ImVec2(center.x + w / 2, center.y + h / 2);
				const uv0 = new ImVec2(comp.flipX ? 1 : 0, comp.flipY ? 1 : 0);
				const uv1 = new ImVec2(comp.flipX ? 0 : 1, comp.flipY ? 0 : 1);
				draw.AddImage(tex.ref, p1, p2, uv0, uv1, comp.tint);
			} else {
				// fallback outline
				for (let i = 0; i < 4; i++) {
					const a = corners[i];
					const b = corners[(i + 1) % 4];
					draw.AddLine(new ImVec2(a.x, a.y), new ImVec2(b.x, b.y), rgba(255, 100, 200), 2.0);
				}
			}
		}
	}

	if (obj.components.length === 0) {
		// empty object → dashed rect
		for (let i = 0; i < 4; i++) {
			const a = corners[i];
			const b = corners[(i + 1) % 4];
			draw.AddLine(new ImVec2(a.x, a.y), new ImVec2(b.x, b.y), rgba(155, 89, 182), 1.5);
		}
		// X mark
		draw.AddLine(new ImVec2(corners[0].x, corners[0].y), new ImVec2(corners[2].x, corners[2].y), rgba(155, 89, 182, 150), 1.0);
		draw.AddLine(new ImVec2(corners[1].x, corners[1].y), new ImVec2(corners[3].x, corners[3].y), rgba(155, 89, 182, 150), 1.0);
	}
}

function drawSelection(draw: any, obj: SceneObject, vp: ViewportRect, isPrimary: boolean): void {
	const corners = getObjectCorners(obj, vp);
	const outlineCol = isPrimary ? rgba(255, 170, 0) : rgba(255, 170, 0, 180);

	for (let i = 0; i < 4; i++) {
		const a = corners[i];
		const b = corners[(i + 1) % 4];
		draw.AddLine(new ImVec2(a.x, a.y), new ImVec2(b.x, b.y), outlineCol, 2.0);
	}

	if (isPrimary) {
		const handlePositions: Array<[number, number]> = [
			[corners[0].x, corners[0].y],
			[(corners[0].x + corners[1].x) / 2, (corners[0].y + corners[1].y) / 2],
			[corners[1].x, corners[1].y],
			[(corners[1].x + corners[2].x) / 2, (corners[1].y + corners[2].y) / 2],
			[corners[2].x, corners[2].y],
			[(corners[2].x + corners[3].x) / 2, (corners[2].y + corners[3].y) / 2],
			[corners[3].x, corners[3].y],
			[(corners[3].x + corners[0].x) / 2, (corners[3].y + corners[0].y) / 2],
		];
		const handleCol = rgba(255, 170, 0);
		const handleSize = 8;
		for (const [hx, hy] of handlePositions) {
			draw.AddRectFilled(new ImVec2(hx - handleSize / 2, hy - handleSize / 2), new ImVec2(hx + handleSize / 2, hy + handleSize / 2), handleCol);
			draw.AddRect(new ImVec2(hx - handleSize / 2, hy - handleSize / 2), new ImVec2(hx + handleSize / 2, hy + handleSize / 2), col(0xff000000), 0, 1.0, 0);
		}

		// rotate handle
		const topMidX = (corners[0].x + corners[1].x) / 2;
		const topMidY = (corners[0].y + corners[1].y) / 2;
		const edgeDx = corners[1].x - corners[0].x;
		const edgeDy = corners[1].y - corners[0].y;
		const edgeLen = Math.hypot(edgeDx, edgeDy) || 1;
		const perpX = -edgeDy / edgeLen;
		const perpY = edgeDx / edgeLen;
		const rotX = topMidX + perpX * 30;
		const rotY = topMidY + perpY * 30;
		draw.AddLine(new ImVec2(topMidX, topMidY), new ImVec2(rotX, rotY), rgba(74, 255, 158, 150), 1.0);
		draw.AddCircleFilled(new ImVec2(rotX, rotY), 7, rgba(74, 255, 158));
		draw.AddCircle(new ImVec2(rotX, rotY), 7, col(0xff000000), 0, 2.0);
	}
}

function drawSnapGuides(draw: any, vp: ViewportRect): void {
	for (const g of state.snapGuides) {
		const p1 = worldToScreen(g.x1, g.y1, vp.originX, vp.originY);
		const p2 = worldToScreen(g.x2, g.y2, vp.originX, vp.originY);
		draw.AddLine(new ImVec2(p1.x, p1.y), new ImVec2(p2.x, p2.y), rgba(0, 212, 255), 1.5);
	}
}

function drawMarquee(draw: any, vp: ViewportRect): void {
	if (!state.marquee) return;
	const p1 = worldToScreen(state.marquee.x1, state.marquee.y1, vp.originX, vp.originY);
	const p2 = worldToScreen(state.marquee.x2, state.marquee.y2, vp.originX, vp.originY);
	const x1 = Math.min(p1.x, p2.x);
	const y1 = Math.min(p1.y, p2.y);
	const x2 = Math.max(p1.x, p2.x);
	const y2 = Math.max(p1.y, p2.y);
	draw.AddRectFilled(new ImVec2(x1, y1), new ImVec2(x2, y2), rgba(74, 168, 255, 60));
	draw.AddRect(new ImVec2(x1, y1), new ImVec2(x2, y2), rgba(74, 168, 255, 200), 0, 1.0, 0);
}

// =============================================================
// Hit testing & handles
// =============================================================

function hitTestObject(obj: SceneObject, worldX: number, worldY: number): boolean {
	const t = obj.transform;
	const dx = worldX - t.x;
	const dy = worldY - t.y;
	const angle = (-t.rotation * Math.PI) / 180;
	const cos = Math.cos(angle);
	const sin = Math.sin(angle);
	const lx = dx * cos - dy * sin;
	const ly = dx * sin + dy * cos;
	return lx >= -t.width / 2 && lx <= t.width / 2 && ly >= -t.height / 2 && ly <= t.height / 2;
}

function findObjectAt(worldX: number, worldY: number): SceneObject | null {
	if (!state.scene) return null;
	for (let i = state.scene.objects.length - 1; i >= 0; i--) {
		const obj = state.scene.objects[i];
		const layer = findLayer(obj.layerId);
		if (layer && (!layer.visible || layer.locked)) continue;
		if (hitTestObject(obj, worldX, worldY)) return obj;
	}
	return null;
}

function getHandlePositions(obj: SceneObject, vp: ViewportRect): Array<{ type: HandleType; x: number; y: number }> {
	const t = obj.transform;
	const angle = (t.rotation * Math.PI) / 180;
	const cos = Math.cos(angle);
	const sin = Math.sin(angle);
	const halfW = t.width / 2;
	const halfH = t.height / 2;
	const locals: Array<[HandleType, number, number]> = [
		["nw", -halfW, -halfH],
		["n", 0, -halfH],
		["ne", halfW, -halfH],
		["e", halfW, 0],
		["se", halfW, halfH],
		["s", 0, halfH],
		["sw", -halfW, halfH],
		["w", -halfW, 0],
	];
	return locals.map(([type, lx, ly]) => {
		const rx = lx * cos - ly * sin;
		const ry = lx * sin + ly * cos;
		const sp = worldToScreen(t.x + rx, t.y + ry, vp.originX, vp.originY);
		return { type, x: sp.x, y: sp.y };
	});
}

function findHandleAt(mx: number, my: number, vp: ViewportRect): { obj: SceneObject; handle: HandleType } | null {
	if (state.selectedIds.length !== 1) return null;
	const obj = findObject(state.selectedIds[0]);
	if (!obj) return null;
	const positions = getHandlePositions(obj, vp);
	for (const p of positions) {
		if (Math.abs(mx - p.x) <= 10 && Math.abs(my - p.y) <= 10) {
			return { obj, handle: p.type };
		}
	}
	return null;
}

function findRotateHandleAt(mx: number, my: number, vp: ViewportRect): SceneObject | null {
	if (state.selectedIds.length !== 1) return null;
	const obj = findObject(state.selectedIds[0]);
	if (!obj) return null;
	const t = obj.transform;
	const angle = (t.rotation * Math.PI) / 180;
	const cos = Math.cos(angle);
	const sin = Math.sin(angle);
	const halfH = t.height / 2;
	const lx = 0,
		ly = -halfH;
	const rx = lx * cos - ly * sin;
	const ry = lx * sin + ly * cos;
	const sp = worldToScreen(t.x + rx, t.y + ry, vp.originX, vp.originY);

	const edgeDx = cos * t.width;
	const edgeDy = sin * t.width;
	const edgeLen = Math.hypot(edgeDx, edgeDy) || 1;
	const perpX = -edgeDy / edgeLen;
	const perpY = edgeDx / edgeLen;
	const rotX = sp.x + perpX * 30;
	const rotY = sp.y + perpY * 30;
	if (Math.hypot(rotX - mx, rotY - my) <= 14) return obj;
	return null;
}

// =============================================================
// Interaction
// =============================================================

function beginDrag(worldX: number, worldY: number, primaryId: string): void {
	const startTransforms = new Map<string, Transform>();
	for (const id of state.selectedIds) {
		const obj = findObject(id);
		if (obj) startTransforms.set(id, { ...obj.transform });
	}
	if (startTransforms.size === 0) {
		const obj = findObject(primaryId);
		if (obj) startTransforms.set(primaryId, { ...obj.transform });
	}
	state.interaction = {
		mode: "drag",
		startWorldX: worldX,
		startWorldY: worldY,
		startScreenX: 0,
		startScreenY: 0,
		startTransforms,
		primaryId,
	};
}

function beginResize(worldX: number, worldY: number, obj: SceneObject, handle: HandleType): void {
	const st = new Map<string, Transform>();
	st.set(obj.id, { ...obj.transform });
	state.interaction = {
		mode: "resize",
		startWorldX: worldX,
		startWorldY: worldY,
		startScreenX: 0,
		startScreenY: 0,
		startTransforms: st,
		primaryId: obj.id,
		handle,
	};
}

function beginRotate(worldX: number, worldY: number, obj: SceneObject): void {
	const startAngle = Math.atan2(worldY - obj.transform.y, worldX - obj.transform.x);
	const st = new Map<string, Transform>();
	st.set(obj.id, { ...obj.transform });
	state.interaction = {
		mode: "rotate",
		startWorldX: worldX,
		startWorldY: worldY,
		startScreenX: 0,
		startScreenY: 0,
		startTransforms: st,
		primaryId: obj.id,
		rotateCenter: { x: obj.transform.x, y: obj.transform.y },
		rotateStartAngle: startAngle,
		rotateStartRotation: obj.transform.rotation,
	};
}

function beginMarquee(worldX: number, worldY: number): void {
	state.interaction = {
		mode: "marquee",
		startWorldX: worldX,
		startWorldY: worldY,
		startScreenX: 0,
		startScreenY: 0,
		startTransforms: new Map(),
		primaryId: "",
	};
	state.marquee = { x1: worldX, y1: worldY, x2: worldX, y2: worldY };
}

function updateDrag(worldX: number, worldY: number): void {
	if (!state.interaction || state.interaction.mode !== "drag") return;
	const it = state.interaction;
	const dx = worldX - it.startWorldX;
	const dy = worldY - it.startWorldY;
	const primaryStart = it.startTransforms.get(it.primaryId);
	if (!primaryStart) return;

	let pX = primaryStart.x + dx;
	let pY = primaryStart.y + dy;

	if (state.scene?.snapToGrid) {
		const gs = state.scene.gridSize;
		pX = Math.round(pX / gs) * gs;
		pY = Math.round(pY / gs) * gs;
	}

	const exclude = new Set(it.startTransforms.keys());
	const primary = findObject(it.primaryId);
	if (primary && state.scene?.snapToObjects) {
		const snap = computeSnap(pX, pY, { ...primary, transform: { ...primaryStart, x: pX, y: pY } } as SceneObject, exclude, 8 / state.camera.zoom);
		pX = snap.x;
		pY = snap.y;
		state.snapGuides = snap.guides;
	} else {
		state.snapGuides = [];
	}

	const sdx = pX - (primaryStart.x + dx);
	const sdy = pY - (primaryStart.y + dy);

	for (const [id, start] of it.startTransforms) {
		const obj = findObject(id);
		if (!obj) continue;
		obj.transform.x = round(start.x + dx + sdx);
		obj.transform.y = round(start.y + dy + sdy);
	}
}

function updateResize(worldX: number, worldY: number, shiftKey: boolean): void {
	if (!state.interaction || state.interaction.mode !== "resize") return;
	const it = state.interaction;
	if (!it.handle) return;
	const obj = findObject(it.primaryId);
	const start = it.startTransforms.get(it.primaryId);
	if (!obj || !start) return;

	const dx = worldX - it.startWorldX;
	const dy = worldY - it.startWorldY;
	const handle = it.handle;
	const isLeft = handle === "w" || handle === "nw" || handle === "sw";
	const isRight = handle === "e" || handle === "ne" || handle === "se";
	const isTop = handle === "n" || handle === "nw" || handle === "ne";
	const isBottom = handle === "s" || handle === "sw" || handle === "se";

	let nW = start.width,
		nH = start.height,
		nX = start.x,
		nY = start.y;
	if (isRight) nW = Math.max(4, start.width + dx);
	if (isLeft) nW = Math.max(4, start.width - dx);
	if (isBottom) nH = Math.max(4, start.height + dy);
	if (isTop) nH = Math.max(4, start.height - dy);
	if (isLeft) nX = start.x + (start.width - nW) / 2;
	if (isRight) nX = start.x + (nW - start.width) / 2;
	if (isTop) nY = start.y + (start.height - nH) / 2;
	if (isBottom) nY = start.y + (nH - start.height) / 2;

	if (shiftKey && isLeft === isRight && isTop === isBottom) {
		const aspect = start.width / start.height;
		if (nW / nH > aspect) nW = nH * aspect;
		else nH = nW / aspect;
	}
	if (state.scene?.snapToGrid) {
		const gs = state.scene.gridSize;
		nW = Math.round(nW / gs) * gs;
		nH = Math.round(nH / gs) * gs;
		nX = Math.round(nX / gs) * gs;
		nY = Math.round(nY / gs) * gs;
	}

	obj.transform.width = round(nW);
	obj.transform.height = round(nH);
	obj.transform.x = round(nX);
	obj.transform.y = round(nY);
}

function updateRotate(worldX: number, worldY: number, shiftKey: boolean, altKey: boolean): void {
	if (!state.interaction || state.interaction.mode !== "rotate") return;
	const it = state.interaction;
	if (!it.rotateCenter || it.rotateStartAngle === undefined || it.rotateStartRotation === undefined) return;
	const obj = findObject(it.primaryId);
	if (!obj) return;
	const currentAngle = Math.atan2(worldY - it.rotateCenter.y, worldX - it.rotateCenter.x);
	let dDeg = ((currentAngle - it.rotateStartAngle) * 180) / Math.PI;
	if (dDeg > 180) dDeg -= 360;
	if (dDeg < -180) dDeg += 360;
	let nRot = it.rotateStartRotation + dDeg;
	if (altKey) nRot = Math.round(nRot / 90) * 90;
	else if (shiftKey) nRot = Math.round(nRot / 15) * 15;
	nRot = ((nRot % 360) + 360) % 360;
	obj.transform.rotation = round(nRot * 100) / 100;
}

function updateMarquee(worldX: number, worldY: number): void {
	if (!state.interaction || state.interaction.mode !== "marquee") return;
	if (!state.marquee) return;
	state.marquee.x2 = worldX;
	state.marquee.y2 = worldY;

	// Live preview selection
	const x1 = Math.min(state.marquee.x1, state.marquee.x2);
	const y1 = Math.min(state.marquee.y1, state.marquee.y2);
	const x2 = Math.max(state.marquee.x1, state.marquee.x2);
	const y2 = Math.max(state.marquee.y1, state.marquee.y2);
	const hits: string[] = [];
	if (state.scene) {
		for (const obj of state.scene.objects) {
			const layer = findLayer(obj.layerId);
			if (layer && (!layer.visible || layer.locked)) continue;
			const b = getObjectBounds(obj);
			const overlaps = !(b.x2 < x1 || b.x1 > x2 || b.y2 < y1 || b.y1 > y2);
			if (overlaps) hits.push(obj.id);
		}
	}
	state.selectedIds = hits;
	state.primaryId = hits[hits.length - 1] ?? null;
}

function endInteraction(): void {
	if (!state.interaction) return;
	if (state.interaction.mode !== "idle" && state.interaction.mode !== "pan" && state.interaction.mode !== "marquee") {
		snapshot();
	}
	if (state.interaction.mode === "marquee") {
		state.marquee = null;
	}
	state.interaction = null;
	state.snapGuides = [];
}

// =============================================================
// Scene rendering
// =============================================================

function renderViewport(vp: ViewportRect): void {
	const draw = ImGui.GetWindowDrawList();

	draw.AddRectFilled(new ImVec2(vp.x, vp.y), new ImVec2(vp.x + vp.w, vp.y + vp.h), col(0xff1a1a1a));
	draw.PushClipRect(new ImVec2(vp.x, vp.y), new ImVec2(vp.x + vp.w, vp.y + vp.h), true);

	drawGrid(draw, vp);
	drawWorldBorder(draw, vp);

	if (state.scene) {
		// sort by layer visibility + zIndex
		const visibleObjects = state.scene.objects
			.filter((o) => {
				const layer = findLayer(o.layerId);
				return !layer || layer.visible;
			})
			.sort((a, b) => a.zIndex - b.zIndex);

		for (const obj of visibleObjects) {
			drawObject(draw, obj, vp);
		}
		for (const id of state.selectedIds) {
			const obj = findObject(id);
			if (obj) drawSelection(draw, obj, vp, id === state.primaryId);
		}
	}

	drawSnapGuides(draw, vp);
	drawMarquee(draw, vp);

	draw.PopClipRect();
	drawRulers(draw, vp);
}

