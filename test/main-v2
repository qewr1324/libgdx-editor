function renderInspector(): void {
	if (!state.scene) return;

	if (state.selectedIds.length === 0) {
		ImGui.TextDisabled("No selection");
		ImGui.Spacing();
		ImGui.TextDisabled("Scene:");
		ImGui.Separator();

		ImGui.SetNextItemWidth(-1);
		let name = [state.scene.name];
		if (ImGui.InputText("##scene_name", name, 128)) {
			state.scene.name = name[0];
		}

		ImGui.SetNextItemWidth(-1);
		let w = [state.scene.worldSize.width];
		if (ImGui.InputFloat("Width", w, 0, 0, "%.0f")) {
			state.scene.worldSize.width = Math.max(16, w[0]);
		}

		ImGui.SetNextItemWidth(-1);
		let h = [state.scene.worldSize.height];
		if (ImGui.InputFloat("Height", h, 0, 0, "%.0f")) {
			state.scene.worldSize.height = Math.max(16, h[0]);
		}

		ImGui.SetNextItemWidth(-1);
		let gs = [state.scene.gridSize];
		if (ImGui.InputFloat("Grid Size", gs, 1, 10, "%.0f")) {
			state.scene.gridSize = Math.max(1, gs[0]);
		}

		return;
	}

	if (state.selectedIds.length > 1) {
		ImGui.Text(`${state.selectedIds.length} objects selected`);
		ImGui.Spacing();
		if (ImGui.Button("Delete All")) deleteSelected();
		return;
	}

	const obj = findObject(state.selectedIds[0]);
	if (!obj) return;

	const t = obj.transform;

	// Name
	ImGui.SetNextItemWidth(-1);
	let name = [obj.name];
	if (ImGui.InputText("##name", name, 128)) obj.name = name[0];

	ImGui.TextDisabled(obj.id);
	ImGui.Separator();

	// Transform
	if (ImGui.CollapsingHeader("Transform", ImGuiTreeNodeFlags.DefaultOpen)) {
		ImGui.SetNextItemWidth(80);
		let x = [t.x];
		if (ImGui.InputFloat("X", x, 1, 10, "%.1f")) t.x = x[0];
		ImGui.SameLine();
		ImGui.SetNextItemWidth(80);
		let y = [t.y];
		if (ImGui.InputFloat("Y", y, 1, 10, "%.1f")) t.y = y[0];

		ImGui.SetNextItemWidth(80);
		let w = [t.width];
		if (ImGui.InputFloat("W", w, 1, 10, "%.1f")) t.width = Math.max(1, w[0]);
		ImGui.SameLine();
		ImGui.SetNextItemWidth(80);
		let h = [t.height];
		if (ImGui.InputFloat("H", h, 1, 10, "%.1f")) t.height = Math.max(1, h[0]);

		ImGui.SetNextItemWidth(-1);
		let rot = [t.rotation];
		if (ImGui.SliderFloat("Rotation", rot, -180, 180, "%.1f deg")) t.rotation = rot[0];

		ImGui.SetNextItemWidth(80);
		let ox = [t.originX];
		if (ImGui.InputFloat("OriginX", ox, 0.05, 0.1, "%.2f")) t.originX = clamp(ox[0], 0, 1);
		ImGui.SameLine();
		ImGui.SetNextItemWidth(80);
		let oy = [t.originY];
		if (ImGui.InputFloat("OriginY", oy, 0.05, 0.1, "%.2f")) t.originY = clamp(oy[0], 0, 1);
	}

	// Layer & Z
	if (ImGui.CollapsingHeader("Layer", ImGuiTreeNodeFlags.DefaultOpen)) {
		ImGui.SetNextItemWidth(-1);
		const currentLayer = findLayer(obj.layerId);
		if (ImGui.BeginCombo("##layer_combo", currentLayer?.name ?? "(none)")) {
			for (const layer of state.scene.layers) {
				if (ImGui.Selectable(layer.name, layer.id === obj.layerId)) {
					obj.layerId = layer.id;
					snapshot();
				}
			}
			ImGui.EndCombo();
		}

		ImGui.SetNextItemWidth(80);
		let z = [obj.zIndex];
		if (ImGui.InputInt("Z-Index", z, 1, 1)) obj.zIndex = z[0];

		if (ImGui.Button("Front")) {
			obj.zIndex = Math.max(...state.scene.objects.map((o) => o.zIndex)) + 1;
			snapshot();
		}
		ImGui.SameLine();
		if (ImGui.Button("Back")) {
			obj.zIndex = Math.min(...state.scene.objects.map((o) => o.zIndex)) - 1;
			snapshot();
		}
	}

	// Components
	if (ImGui.CollapsingHeader("Components", ImGuiTreeNodeFlags.DefaultOpen)) {
		for (let i = 0; i < obj.components.length; i++) {
			const comp = obj.components[i];
			ImGui.PushID(`${comp.id}_${i}`);
			renderComponentInspector(obj, comp);
			ImGui.PopID();
		}

		ImGui.Spacing();
		if (ImGui.Button("+ Add Component", new ImVec2(-1, 0))) {
			ImGui.OpenPopup("add_comp");
		}
		if (ImGui.BeginPopup("add_comp")) {
			if (ImGui.MenuItem("Sprite")) addComponent(obj, { id: makeId("comp"), type: "sprite", texturePath: "", tint: rgba(255, 255, 255), flipX: false, flipY: false });
			if (ImGui.MenuItem("Shape")) addComponent(obj, { id: makeId("comp"), type: "shape", shape: "rectangle", color: rgba(74, 158, 255), filled: true, strokeWidth: 2 });
			if (ImGui.MenuItem("Text")) addComponent(obj, { id: makeId("comp"), type: "text", text: "Label", color: rgba(255, 255, 255), fontSize: 18 });
			if (ImGui.MenuItem("Physics")) addComponent(obj, { id: makeId("comp"), type: "physics", bodyType: "dynamic", mass: 1, gravityScale: 1, velocityX: 0, velocityY: 0, fixedRotation: false });
			if (ImGui.MenuItem("Collider")) addComponent(obj, { id: makeId("comp"), type: "collider", shape: "box", isTrigger: false, friction: 0.2, restitution: 0 });
			if (ImGui.MenuItem("Tag")) addComponent(obj, { id: makeId("comp"), type: "tag", tags: [] });
			ImGui.EndPopup();
		}
	}
}

function renderComponentInspector(obj: SceneObject, comp: Component): void {
	const header = `${comp.type.toUpperCase()}`;
	if (!ImGui.CollapsingHeader(header, ImGuiTreeNodeFlags.DefaultOpen)) return;

	// remove button on the right
	const avail = ImGui.GetContentRegionAvail();
	if (comp.type === "sprite") {
		const c = comp as SpriteComponent;
		ImGui.Text(`Texture: ${c.texturePath || "(none)"}`);
		if (ImGui.Button("Choose Texture")) {
			ImGui.OpenPopup("choose_tex");
		}
		if (ImGui.BeginPopup("choose_tex")) {
			for (const [path] of state.textures) {
				if (ImGui.MenuItem(path)) {
					c.texturePath = path;
					const tex = state.textures.get(path);
					if (tex) {
						obj.transform.width = tex.width;
						obj.transform.height = tex.height;
					}
					snapshot();
				}
			}
			if (state.textures.size === 0) ImGui.TextDisabled("No textures loaded");
			ImGui.EndPopup();
		}
		ImGui.Checkbox("Flip X", [c.flipX]);
		// NOTE: Checkbox takes pointer; jsimgui binding should accept [bool]
	} else if (comp.type === "shape") {
		const c = comp as ShapeComponent;
		const shapes: VisualShape[] = ["rectangle", "circle", "triangle", "diamond", "pentagon", "hexagon", "star"];
		if (ImGui.BeginCombo("Shape", c.shape)) {
			for (const s of shapes) {
				if (ImGui.Selectable(s, s === c.shape)) {
					c.shape = s;
					snapshot();
				}
			}
			ImGui.EndCombo();
		}
		// Color edit — ImGui wants array of 4 floats; convert
		const r = (c.color & 0xff) / 255;
		const g = ((c.color >>> 8) & 0xff) / 255;
		const b = ((c.color >>> 16) & 0xff) / 255;
		const a = ((c.color >>> 24) & 0xff) / 255;
		const rgbaArr: [number, number, number, number] = [r, g, b, a];
		if (ImGui.ColorEdit4("Color", rgbaArr)) {
			c.color = rgba(rgbaArr[0] * 255, rgbaArr[1] * 255, rgbaArr[2] * 255, rgbaArr[3] * 255);
		}
		const fillArr: [boolean] = [c.filled];
		if (ImGui.Checkbox("Filled", fillArr)) c.filled = fillArr[0];
		const swArr: [number] = [c.strokeWidth];
		if (ImGui.SliderFloat("Stroke Width", swArr, 0.5, 10)) c.strokeWidth = swArr[0];
	} else if (comp.type === "text") {
		const c = comp as TextComponent;
		ImGui.SetNextItemWidth(-1);
		let txt = [c.text];
		if (ImGui.InputText("##text", txt, 512)) c.text = txt[0];
		const fsArr: [number] = [c.fontSize];
		ImGui.SetNextItemWidth(-1);
		if (ImGui.SliderFloat("Font Size", fsArr, 6, 72)) c.fontSize = fsArr[0];
		const r = (c.color & 0xff) / 255;
		const g = ((c.color >>> 8) & 0xff) / 255;
		const b = ((c.color >>> 16) & 0xff) / 255;
		const a = ((c.color >>> 24) & 0xff) / 255;
		const rgbaArr: [number, number, number, number] = [r, g, b, a];
		if (ImGui.ColorEdit4("Color", rgbaArr)) {
			c.color = rgba(rgbaArr[0] * 255, rgbaArr[1] * 255, rgbaArr[2] * 255, rgbaArr[3] * 255);
		}
	} else if (comp.type === "physics") {
		const c = comp as PhysicsComponent;
		const types = ["dynamic", "static", "kinematic"];
		if (ImGui.BeginCombo("Body Type", c.bodyType)) {
			for (const t of types) {
				if (ImGui.Selectable(t, t === c.bodyType)) {
					c.bodyType = t as any;
					snapshot();
				}
			}
			ImGui.EndCombo();
		}
		let massArr: [number] = [c.mass];
		if (ImGui.InputFloat("Mass", massArr)) c.mass = massArr[0];
		let gsArr: [number] = [c.gravityScale];
		if (ImGui.InputFloat("Gravity Scale", gsArr)) c.gravityScale = gsArr[0];
		let vxArr: [number] = [c.velocityX];
		if (ImGui.InputFloat("Vel X", vxArr)) c.velocityX = vxArr[0];
		let vyArr: [number] = [c.velocityY];
		if (ImGui.InputFloat("Vel Y", vyArr)) c.velocityY = vyArr[0];
	} else if (comp.type === "collider") {
		const c = comp as ColliderComponent;
		const shapes = ["box", "circle"];
		if (ImGui.BeginCombo("Shape", c.shape)) {
			for (const s of shapes) {
				if (ImGui.Selectable(s, s === c.shape)) {
					c.shape = s as any;
					snapshot();
				}
			}
			ImGui.EndCombo();
		}
		let fArr: [number] = [c.friction];
		if (ImGui.InputFloat("Friction", fArr)) c.friction = fArr[0];
		let rArr: [number] = [c.restitution];
		if (ImGui.InputFloat("Restitution", rArr)) c.restitution = rArr[0];
	} else if (comp.type === "tag") {
		const c = comp as TagComponent;
		const tagsStr = c.tags.join(", ");
		let tags = [tagsStr];
		if (ImGui.InputText("Tags", tags, 256)) {
			c.tags = tags[0]
				.split(",")
				.map((s) => s.trim())
				.filter(Boolean);
		}
	}

	// remove button
	if (ImGui.Button("Remove Component")) {
		removeComponent(obj, comp.id);
		snapshot();
	}
}

