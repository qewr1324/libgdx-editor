function renderViewport(vp: ViewportRect): void {
	const draw = ImGui.GetWindowDrawList();

	draw.AddRectFilled(new ImVec2(vp.x, vp.y), new ImVec2(vp.x + vp.w, vp.y + vp.h), col(0xff1a1a1a));

	draw.PushClipRect(new ImVec2(vp.x, vp.y), new ImVec2(vp.x + vp.w, vp.y + vp.h), true);

	drawGrid(draw, vp);
	drawWorldBorder(draw, vp);

	if (state.scene) {
		for (const obj of state.scene.objects) {
			drawObject(draw, obj, vp);
		}
		for (const id of state.selectedIds) {
			const obj = findObject(id);
			if (obj) drawSelection(draw, obj, vp, id === state.primaryId);
		}
	}

	drawSnapGuides(draw, vp);

	draw.PopClipRect();

	drawRulers(draw, vp);
}

