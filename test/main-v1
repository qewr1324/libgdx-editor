// @ts-nocheck
/**
 * Scene Viewport — ImGui + WebGL2
 * Crisp rendering with HiDPI support and proper anti-aliasing.
 */

import { ImGui, ImGuiImplWeb, ImVec2, ImVec4, ImGuiWindowFlags, ImGuiChildFlags, ImGuiCol, ImGuiStyleVar, ImGuiMouseButton, ImGuiMouseCursor, ImGuiKey, ImGuiCond } from "@mori2003/jsimgui";

// =============================================================
// Types
// =============================================================

type ObjectType = "rectangle" | "circle" | "triangle" | "diamond" | "star" | "text";

interface Transform {
	x: number;
	y: number;
	width: number;
	height: number;
	rotation: number;
	originX: number;
	originY: number;
}

interface SceneObject {
	id: string;
	name: string;
	type: ObjectType;
	color: number;
	transform: Transform;
	text?: string;
}

interface Scene {
	name: string;
	worldSize: { width: number; height: number };
	backgroundColor: number;
	gridSize: number;
	snapToGrid: boolean;
	snapToObjects: boolean;
	showGrid: boolean;
	showWorldBorder: boolean;
	showRulers: boolean;
	objects: SceneObject[];
}

type InteractionMode = "idle" | "drag" | "resize" | "rotate" | "pan";

interface InteractionData {
	mode: InteractionMode;
	startWorldX: number;
	startWorldY: number;
	startScreenX: number;
	startScreenY: number;
	startTransforms: Map<string, Transform>;
	primaryId: string;
	handle?: HandleType;
	rotateCenter?: { x: number; y: number };
	rotateStartAngle?: number;
	rotateStartRotation?: number;
	panStartX?: number;
	panStartY?: number;
}

type HandleType = "nw" | "n" | "ne" | "e" | "se" | "s" | "sw" | "w";

// =============================================================
// Utility
// =============================================================

function rgba(r: number, g: number, b: number, a = 255): number {
	return (((a & 0xff) << 24) | ((b & 0xff) << 16) | ((g & 0xff) << 8) | (r & 0xff)) >>> 0;
}

function col(hex: number): number {
	return hex >>> 0;
}

function makeId(prefix = "obj"): string {
	return `${prefix}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 7)}`;
}

function round(n: number): number {
	return Math.round(n);
}

// =============================================================
// Global state
// =============================================================

const state = {
	scene: null as Scene | null,
	selectedIds: [] as string[],
	primaryId: null as string | null,
	interaction: null as InteractionData | null,
	camera: { x: 0, y: 0, zoom: 1 },
	history: [] as string[],
	historyIndex: -1,
	snapGuides: [] as Array<{ x1: number; y1: number; x2: number; y2: number }>,
	contextMenu: {
		open: false,
		x: 0,
		y: 0,
		worldX: 0,
		worldY: 0,
	},
};

// =============================================================
// Camera <-> World
// =============================================================

function worldToScreen(wx: number, wy: number, originX: number, originY: number) {
	return {
		x: originX + (wx - state.camera.x) * state.camera.zoom,
		y: originY + (wy - state.camera.y) * state.camera.zoom,
	};
}

function screenToWorld(sx: number, sy: number, originX: number, originY: number) {
	return {
		x: (sx - originX) / state.camera.zoom + state.camera.x,
		y: (sy - originY) / state.camera.zoom + state.camera.y,
	};
}

// =============================================================
// Object creation & lookup
// =============================================================

function createObject(type: ObjectType, x: number, y: number): SceneObject {
	const id = makeId();
	const palette: Record<ObjectType, number> = {
		rectangle: rgba(74, 158, 255),
		circle: rgba(74, 255, 158),
		triangle: rgba(255, 170, 74),
		diamond: rgba(74, 255, 255),
		star: rgba(255, 74, 255),
		text: rgba(255, 255, 255),
	};
	return {
		id,
		name: `${type}_${id.slice(-4)}`,
		type,
		color: palette[type],
		transform: {
			x,
			y,
			width: 100,
			height: 80,
			rotation: 0,
			originX: 0.5,
			originY: 0.5,
		},
		text: type === "text" ? "Label" : undefined,
	};
}

function findObject(id: string): SceneObject | null {
	return state.scene?.objects.find((o) => o.id === id) ?? null;
}

// =============================================================
// History
// =============================================================

function snapshot(): void {
	if (!state.scene) return;
	const json = JSON.stringify(state.scene);
	if (state.historyIndex >= 0 && state.history[state.historyIndex] === json) return;
	state.history = state.history.slice(0, state.historyIndex + 1);
	state.history.push(json);
	state.historyIndex = state.history.length - 1;
	if (state.history.length > 100) {
		state.history.shift();
		state.historyIndex--;
	}
}

function undo(): void {
	if (state.historyIndex <= 0) return;
	state.historyIndex--;
	state.scene = JSON.parse(state.history[state.historyIndex]);
}

function redo(): void {
	if (state.historyIndex >= state.history.length - 1) return;
	state.historyIndex++;
	state.scene = JSON.parse(state.history[state.historyIndex]);
}

// =============================================================
// Snapping
// =============================================================

interface SnapResult {
	x: number;
	y: number;
	guides: Array<{ x1: number; y1: number; x2: number; y2: number }>;
}

function computeSnap(proposedX: number, proposedY: number, primary: SceneObject, excludeIds: Set<string>, threshold: number): SnapResult {
	if (!state.scene) return { x: proposedX, y: proposedY, guides: [] };

	const guides: Array<{ x1: number; y1: number; x2: number; y2: number }> = [];
	const t = primary.transform;

	const mLeft = proposedX - t.width * t.originX;
	const mRight = mLeft + t.width;
	const mTop = proposedY - t.height * t.originY;
	const mBottom = mTop + t.height;
	const mCenterX = proposedX;
	const mCenterY = proposedY;

	let bestX: { delta: number; snapX: number; ref: { min: number; max: number } } | null = null;
	let bestY: { delta: number; snapY: number; ref: { min: number; max: number } } | null = null;

	const considerX = (mVal: number, oVal: number, refMin: number, refMax: number) => {
		const delta = oVal - mVal;
		if (Math.abs(delta) <= threshold) {
			if (!bestX || Math.abs(delta) < Math.abs(bestX.delta)) {
				bestX = { delta, snapX: oVal, ref: { min: refMin, max: refMax } };
			}
		}
	};

	const considerY = (mVal: number, oVal: number, refMin: number, refMax: number) => {
		const delta = oVal - mVal;
		if (Math.abs(delta) <= threshold) {
			if (!bestY || Math.abs(delta) < Math.abs(bestY.delta)) {
				bestY = { delta, snapY: oVal, ref: { min: refMin, max: refMax } };
			}
		}
	};

	if (state.scene.snapToObjects) {
		const W = state.scene.worldSize.width;
		const H = state.scene.worldSize.height;
		considerX(mLeft, 0, mTop, mBottom);
		considerX(mRight, W, mTop, mBottom);
		considerX(mCenterX, W / 2, mTop, mBottom);
		considerY(mTop, 0, mLeft, mRight);
		considerY(mBottom, H, mLeft, mRight);
		considerY(mCenterY, H / 2, mLeft, mRight);

		for (const obj of state.scene.objects) {
			if (excludeIds.has(obj.id)) continue;
			const ot = obj.transform;
			const oLeft = ot.x - ot.width * ot.originX;
			const oRight = oLeft + ot.width;
			const oTop = ot.y - ot.height * ot.originY;
			const oBottom = oTop + ot.height;
			const oCenterX = ot.x;
			const oCenterY = ot.y;

			considerX(mLeft, oLeft, Math.min(oTop, mTop), Math.max(oBottom, mBottom));
			considerX(mLeft, oRight, Math.min(oTop, mTop), Math.max(oBottom, mBottom));
			considerX(mRight, oLeft, Math.min(oTop, mTop), Math.max(oBottom, mBottom));
			considerX(mRight, oRight, Math.min(oTop, mTop), Math.max(oBottom, mBottom));
			considerX(mCenterX, oCenterX, Math.min(oTop, mTop), Math.max(oBottom, mBottom));

			considerY(mTop, oTop, Math.min(oLeft, mLeft), Math.max(oRight, mRight));
			considerY(mTop, oBottom, Math.min(oLeft, mLeft), Math.max(oRight, mRight));
			considerY(mBottom, oTop, Math.min(oLeft, mLeft), Math.max(oRight, mRight));
			considerY(mBottom, oBottom, Math.min(oLeft, mLeft), Math.max(oRight, mRight));
			considerY(mCenterY, oCenterY, Math.min(oLeft, mLeft), Math.max(oRight, mRight));
		}
	}

	const finalX = bestX ? proposedX + bestX.delta : proposedX;
	const finalY = bestY ? proposedY + bestY.delta : proposedY;

	if (bestX) {
		const b = bestX as { snapX: number; ref: { min: number; max: number } };
		guides.push({ x1: b.snapX, y1: b.ref.min - 20, x2: b.snapX, y2: b.ref.max + 20 });
	}
	if (bestY) {
		const b = bestY as { snapY: number; ref: { min: number; max: number } };
		guides.push({ x1: b.ref.min - 20, y1: b.snapY, x2: b.ref.max + 20, y2: b.snapY });
	}

	return { x: finalX, y: finalY, guides };
}

// =============================================================
// Rendering — using ImDrawList with proper anti-aliasing
// =============================================================

interface ViewportRect {
	x: number;
	y: number;
	w: number;
	h: number;
	originX: number;
	originY: number;
}

function drawGrid(draw: any, vp: ViewportRect): void {
	if (!state.scene || !state.scene.showGrid) return;

	const gs = state.scene.gridSize;
	const zoom = state.camera.zoom;

	const wMin = screenToWorld(0, 0, vp.originX, vp.originY);
	const wMax = screenToWorld(vp.w, vp.h, vp.originX, vp.originY);

	const startX = Math.floor(wMin.x / gs) * gs;
	const startY = Math.floor(wMin.y / gs) * gs;
	const endX = Math.ceil(wMax.x / gs) * gs;
	const endY = Math.ceil(wMax.y / gs) * gs;

	let major = gs;
	while (major * zoom < 40) major *= 2;

	const gridColor = col(0x30ffffff);
	const majorColor = col(0x50ffffff);

	for (let x = startX; x <= endX; x += gs) {
		const isMajor = Math.abs(x % major) < 0.001;
		const sp = worldToScreen(x, 0, vp.originX, vp.originY);
		if (sp.x < vp.x || sp.x > vp.x + vp.w) continue;
		draw.AddLine(new ImVec2(sp.x, vp.y), new ImVec2(sp.x, vp.y + vp.h), isMajor ? majorColor : gridColor, 1.0);
	}

	for (let y = startY; y <= endY; y += gs) {
		const isMajor = Math.abs(y % major) < 0.001;
		const sp = worldToScreen(0, y, vp.originX, vp.originY);
		if (sp.y < vp.y || sp.y > vp.y + vp.h) continue;
		draw.AddLine(new ImVec2(vp.x, sp.y), new ImVec2(vp.x + vp.w, sp.y), isMajor ? majorColor : gridColor, 1.0);
	}
}

function drawWorldBorder(draw: any, vp: ViewportRect): void {
	if (!state.scene || !state.scene.showWorldBorder) return;

	const tl = worldToScreen(0, 0, vp.originX, vp.originY);
	const br = worldToScreen(state.scene.worldSize.width, state.scene.worldSize.height, vp.originX, vp.originY);

	draw.AddRect(new ImVec2(tl.x, tl.y), new ImVec2(br.x, br.y), rgba(74, 168, 255), 0, 2.0, 0);
}

function drawRulers(draw: any, vp: ViewportRect): void {
	if (!state.scene || !state.scene.showRulers) return;

	const rulerH = 22;
	const rulerW = 22;
	const bgTop = col(0xff252525);
	const bgCorner = col(0xff202020);
	const borderCol = col(0xff404040);
	const tickCol = col(0xff707070);
	const textColor = col(0xffb0b0b0);

	draw.AddRectFilled(new ImVec2(vp.x, vp.y - rulerH), new ImVec2(vp.x + vp.w, vp.y), bgTop);
	draw.AddLine(new ImVec2(vp.x, vp.y), new ImVec2(vp.x + vp.w, vp.y), borderCol, 1.0);

	draw.AddRectFilled(new ImVec2(vp.x - rulerW, vp.y), new ImVec2(vp.x, vp.y + vp.h), bgTop);
	draw.AddLine(new ImVec2(vp.x, vp.y), new ImVec2(vp.x, vp.y + vp.h), borderCol, 1.0);

	draw.AddRectFilled(new ImVec2(vp.x - rulerW, vp.y - rulerH), new ImVec2(vp.x, vp.y), bgCorner);

	const zoom = state.camera.zoom;
	let step = 100;
	while (step * zoom < 60) step *= 2;
	while (step * zoom > 200) step /= 2;

	const wMin = screenToWorld(vp.x, 0, vp.originX, vp.originY);
	const wMax = screenToWorld(vp.x + vp.w, 0, vp.originX, vp.originY);
	const startX = Math.floor(wMin.x / step) * step;

	for (let wx = startX; wx <= wMax.x; wx += step) {
		const sp = worldToScreen(wx, 0, vp.originX, vp.originY);
		if (sp.x < vp.x || sp.x > vp.x + vp.w) continue;
		draw.AddLine(new ImVec2(sp.x, vp.y - 8), new ImVec2(sp.x, vp.y), tickCol, 1.0);
		draw.AddText(new ImVec2(sp.x + 3, vp.y - rulerH + 4), textColor, String(wx));
	}

	const hMin = screenToWorld(0, vp.y, vp.originX, vp.originY);
	const hMax = screenToWorld(0, vp.y + vp.h, vp.originX, vp.originY);
	const startY = Math.floor(hMin.y / step) * step;

	for (let wy = startY; wy <= hMax.y; wy += step) {
		const sp = worldToScreen(0, wy, vp.originX, vp.originY);
		if (sp.y < vp.y || sp.y > vp.y + vp.h) continue;
		draw.AddLine(new ImVec2(vp.x - 8, sp.y), new ImVec2(vp.x, sp.y), tickCol, 1.0);
		draw.AddText(new ImVec2(vp.x - rulerW + 2, sp.y + 3), textColor, String(wy));
	}
}

function getObjectCorners(obj: SceneObject, vp: ViewportRect) {
	const t = obj.transform;
	const angle = (t.rotation * Math.PI) / 180;
	const cos = Math.cos(angle);
	const sin = Math.sin(angle);

	const halfW = t.width / 2;
	const halfH = t.height / 2;
	const localCorners: Array<[number, number]> = [
		[-halfW * (t.originX * 2), -halfH * (t.originY * 2)],
		[halfW * (2 - t.originX * 2), -halfH * (t.originY * 2)],
		[halfW * (2 - t.originX * 2), halfH * (2 - t.originY * 2)],
		[-halfW * (t.originX * 2), halfH * (2 - t.originY * 2)],
	];

	return localCorners.map(([lx, ly]) => {
		const rx = lx * cos - ly * sin;
		const ry = lx * sin + ly * cos;
		return worldToScreen(t.x + rx, t.y + ry, vp.originX, vp.originY);
	});
}

function drawObject(draw: any, obj: SceneObject, vp: ViewportRect): void {
	const t = obj.transform;
	const zoom = state.camera.zoom;
	const w = t.width * zoom;
	const h = t.height * zoom;
	const screenCenter = worldToScreen(t.x, t.y, vp.originX, vp.originY);

	const corners = getObjectCorners(obj, vp);
	const objCol = obj.color;

	switch (obj.type) {
		case "rectangle": {
			const fill = ((objCol & 0x00ffffff) | 0x40000000) >>> 0;
			draw.AddQuadFilled(new ImVec2(corners[0].x, corners[0].y), new ImVec2(corners[1].x, corners[1].y), new ImVec2(corners[2].x, corners[2].y), new ImVec2(corners[3].x, corners[3].y), fill);
			for (let i = 0; i < 4; i++) {
				const a = corners[i];
				const b = corners[(i + 1) % 4];
				draw.AddLine(new ImVec2(a.x, a.y), new ImVec2(b.x, b.y), objCol, 2.0);
			}
			break;
		}

		case "circle": {
			const r = Math.min(w, h) / 2;
			draw.AddCircleFilled(new ImVec2(screenCenter.x, screenCenter.y), r, ((objCol & 0x00ffffff) | 0x40000000) >>> 0, 0);
			draw.AddCircle(new ImVec2(screenCenter.x, screenCenter.y), r, objCol, 0, 2.0);
			break;
		}

		case "triangle": {
			const p1 = corners[0];
			const p2 = corners[1];
			const p3 = corners[3];
			draw.AddTriangle(new ImVec2(p1.x, p1.y), new ImVec2(p2.x, p2.y), new ImVec2(p3.x, p3.y), objCol, 2.0);
			break;
		}

		case "diamond": {
			const halfW = t.width / 2;
			const halfH = t.height / 2;
			const top = worldToScreen(t.x, t.y - halfH, vp.originX, vp.originY);
			const right = worldToScreen(t.x + halfW, t.y, vp.originX, vp.originY);
			const bottom = worldToScreen(t.x, t.y + halfH, vp.originX, vp.originY);
			const left = worldToScreen(t.x - halfW, t.y, vp.originX, vp.originY);
			draw.AddQuad(new ImVec2(top.x, top.y), new ImVec2(right.x, right.y), new ImVec2(bottom.x, bottom.y), new ImVec2(left.x, left.y), objCol, 2.0);
			break;
		}

		case "star": {
			const r = Math.min(w, h) / 2;
			const innerR = r * 0.45;
			const points = 5;
			const cx = screenCenter.x;
			const cy = screenCenter.y;
			for (let i = 0; i < points * 2; i++) {
				const rr = i % 2 === 0 ? r : innerR;
				const a = -Math.PI / 2 + (i * Math.PI) / points;
				const x1 = cx + Math.cos(a) * rr;
				const y1 = cy + Math.sin(a) * rr;
				const a2 = -Math.PI / 2 + ((i + 1) * Math.PI) / points;
				const rr2 = (i + 1) % 2 === 0 ? r : innerR;
				const x2 = cx + Math.cos(a2) * rr2;
				const y2 = cy + Math.sin(a2) * rr2;
				draw.AddLine(new ImVec2(x1, y1), new ImVec2(x2, y2), objCol, 2.0);
			}
			break;
		}

		case "text": {
			draw.AddText(new ImVec2(screenCenter.x - 30, screenCenter.y - 8), objCol, obj.text ?? obj.name);
			break;
		}
	}
}

function drawSelection(draw: any, obj: SceneObject, vp: ViewportRect, isPrimary: boolean): void {
	const corners = getObjectCorners(obj, vp);
	const outlineCol = isPrimary ? rgba(255, 170, 0) : rgba(255, 170, 0, 180);

	for (let i = 0; i < 4; i++) {
		const a = corners[i];
		const b = corners[(i + 1) % 4];
		draw.AddLine(new ImVec2(a.x, a.y), new ImVec2(b.x, b.y), outlineCol, 2.0);
	}

	if (isPrimary) {
		const handlePositions: Array<[number, number]> = [
			[corners[0].x, corners[0].y],
			[(corners[0].x + corners[1].x) / 2, (corners[0].y + corners[1].y) / 2],
			[corners[1].x, corners[1].y],
			[(corners[1].x + corners[2].x) / 2, (corners[1].y + corners[2].y) / 2],
			[corners[2].x, corners[2].y],
			[(corners[2].x + corners[3].x) / 2, (corners[2].y + corners[3].y) / 2],
			[corners[3].x, corners[3].y],
			[(corners[3].x + corners[0].x) / 2, (corners[3].y + corners[0].y) / 2],
		];

		const handleCol = rgba(255, 170, 0);
		const handleSize = 8;
		for (const [hx, hy] of handlePositions) {
			draw.AddRectFilled(new ImVec2(hx - handleSize / 2, hy - handleSize / 2), new ImVec2(hx + handleSize / 2, hy + handleSize / 2), handleCol);
			draw.AddRect(new ImVec2(hx - handleSize / 2, hy - handleSize / 2), new ImVec2(hx + handleSize / 2, hy + handleSize / 2), col(0xff000000), 0, 1.0, 0);
		}

		const topMidX = (corners[0].x + corners[1].x) / 2;
		const topMidY = (corners[0].y + corners[1].y) / 2;
		const edgeDx = corners[1].x - corners[0].x;
		const edgeDy = corners[1].y - corners[0].y;
		const edgeLen = Math.hypot(edgeDx, edgeDy) || 1;
		const perpX = -edgeDy / edgeLen;
		const perpY = edgeDx / edgeLen;
		const rotDist = 30;
		const rotX = topMidX + perpX * rotDist;
		const rotY = topMidY + perpY * rotDist;

		draw.AddLine(new ImVec2(topMidX, topMidY), new ImVec2(rotX, rotY), rgba(74, 255, 158, 150), 1.0);
		draw.AddCircleFilled(new ImVec2(rotX, rotY), 7, rgba(74, 255, 158));
		draw.AddCircle(new ImVec2(rotX, rotY), 7, col(0xff000000), 0, 2.0);
	}
}

function drawSnapGuides(draw: any, vp: ViewportRect): void {
	for (const g of state.snapGuides) {
		const p1 = worldToScreen(g.x1, g.y1, vp.originX, vp.originY);
		const p2 = worldToScreen(g.x2, g.y2, vp.originX, vp.originY);
		draw.AddLine(new ImVec2(p1.x, p1.y), new ImVec2(p2.x, p2.y), rgba(0, 212, 255), 1.5);
	}
}

// =============================================================
// Hit testing
// =============================================================

function hitTestObject(obj: SceneObject, worldX: number, worldY: number): boolean {
	const t = obj.transform;
	const dx = worldX - t.x;
	const dy = worldY - t.y;
	const angle = (-t.rotation * Math.PI) / 180;
	const cos = Math.cos(angle);
	const sin = Math.sin(angle);
	const lx = dx * cos - dy * sin;
	const ly = dx * sin + dy * cos;
	const halfW = t.width / 2;
	const halfH = t.height / 2;
	return lx >= -halfW && lx <= halfW && ly >= -halfH && ly <= halfH;
}

function findObjectAt(worldX: number, worldY: number): SceneObject | null {
	if (!state.scene) return null;
	for (let i = state.scene.objects.length - 1; i >= 0; i--) {
		const obj = state.scene.objects[i];
		if (hitTestObject(obj, worldX, worldY)) return obj;
	}
	return null;
}

// =============================================================
// Handle detection
// =============================================================

function getHandlePositions(obj: SceneObject, vp: ViewportRect): Array<{ type: HandleType; x: number; y: number }> {
	const t = obj.transform;
	const angle = (t.rotation * Math.PI) / 180;
	const cos = Math.cos(angle);
	const sin = Math.sin(angle);
	const halfW = t.width / 2;
	const halfH = t.height / 2;

	const localPoints: Array<[HandleType, number, number]> = [
		["nw", -halfW, -halfH],
		["n", 0, -halfH],
		["ne", halfW, -halfH],
		["e", halfW, 0],
		["se", halfW, halfH],
		["s", 0, halfH],
		["sw", -halfW, halfH],
		["w", -halfW, 0],
	];

	return localPoints.map(([type, lx, ly]) => {
		const rx = lx * cos - ly * sin;
		const ry = lx * sin + ly * cos;
		const sp = worldToScreen(t.x + rx, t.y + ry, vp.originX, vp.originY);
		return { type, x: sp.x, y: sp.y };
	});
}

function findHandleAt(mx: number, my: number, vp: ViewportRect): { obj: SceneObject; handle: HandleType } | null {
	if (state.selectedIds.length !== 1) return null;
	const obj = findObject(state.selectedIds[0]);
	if (!obj) return null;
	const positions = getHandlePositions(obj, vp);
	const HIT = 10;
	for (const p of positions) {
		if (Math.abs(mx - p.x) <= HIT && Math.abs(my - p.y) <= HIT) {
			return { obj, handle: p.type };
		}
	}
	return null;
}

function findRotateHandleAt(mx: number, my: number, vp: ViewportRect): SceneObject | null {
	if (state.selectedIds.length !== 1) return null;
	const obj = findObject(state.selectedIds[0]);
	if (!obj) return null;
	const t = obj.transform;
	const angle = (t.rotation * Math.PI) / 180;
	const cos = Math.cos(angle);
	const sin = Math.sin(angle);
	const halfH = t.height / 2;
	const lx = 0;
	const ly = -halfH;
	const rx = lx * cos - ly * sin;
	const ry = lx * sin + ly * cos;
	const sp = worldToScreen(t.x + rx, t.y + ry, vp.originX, vp.originY);

	const edgeDx = cos * t.width;
	const edgeDy = sin * t.width;
	const edgeLen = Math.hypot(edgeDx, edgeDy) || 1;
	const perpX = -edgeDy / edgeLen;
	const perpY = edgeDx / edgeLen;
	const rotDist = 30;
	const rotX = sp.x + perpX * rotDist;
	const rotY = sp.y + perpY * rotDist;

	const dx = rotX - mx;
	const dy = rotY - my;
	if (Math.hypot(dx, dy) <= 14) return obj;
	return null;
}

// =============================================================
// Interaction
// =============================================================

function beginDrag(worldX: number, worldY: number, primaryId: string): void {
	const startTransforms = new Map<string, Transform>();
	for (const id of state.selectedIds) {
		const obj = findObject(id);
		if (obj) startTransforms.set(id, { ...obj.transform });
	}
	if (startTransforms.size === 0) {
		const obj = findObject(primaryId);
		if (obj) startTransforms.set(primaryId, { ...obj.transform });
	}
	state.interaction = {
		mode: "drag",
		startWorldX: worldX,
		startWorldY: worldY,
		startScreenX: 0,
		startScreenY: 0,
		startTransforms,
		primaryId,
	};
}

function beginResize(worldX: number, worldY: number, obj: SceneObject, handle: HandleType): void {
	const startTransforms = new Map<string, Transform>();
	startTransforms.set(obj.id, { ...obj.transform });
	state.interaction = {
		mode: "resize",
		startWorldX: worldX,
		startWorldY: worldY,
		startScreenX: 0,
		startScreenY: 0,
		startTransforms,
		primaryId: obj.id,
		handle,
	};
}

function beginRotate(worldX: number, worldY: number, obj: SceneObject): void {
	const startAngle = Math.atan2(worldY - obj.transform.y, worldX - obj.transform.x);
	const startTransforms = new Map<string, Transform>();
	startTransforms.set(obj.id, { ...obj.transform });
	state.interaction = {
		mode: "rotate",
		startWorldX: worldX,
		startWorldY: worldY,
		startScreenX: 0,
		startScreenY: 0,
		startTransforms,
		primaryId: obj.id,
		rotateCenter: { x: obj.transform.x, y: obj.transform.y },
		rotateStartAngle: startAngle,
		rotateStartRotation: obj.transform.rotation,
	};
}

function updateDrag(worldX: number, worldY: number): void {
	if (!state.interaction || state.interaction.mode !== "drag") return;
	const it = state.interaction;
	const dx = worldX - it.startWorldX;
	const dy = worldY - it.startWorldY;

	const primaryStart = it.startTransforms.get(it.primaryId);
	if (!primaryStart) return;

	let proposedX = primaryStart.x + dx;
	let proposedY = primaryStart.y + dy;

	if (state.scene?.snapToGrid) {
		const gs = state.scene.gridSize || 32;
		proposedX = Math.round(proposedX / gs) * gs;
		proposedY = Math.round(proposedY / gs) * gs;
	}

	const exclude = new Set(it.startTransforms.keys());
	const primary = findObject(it.primaryId);
	const threshold = 8 / state.camera.zoom;

	if (primary && state.scene?.snapToObjects) {
		const snap = computeSnap(proposedX, proposedY, { ...primary, transform: { ...primaryStart, x: proposedX, y: proposedY } } as SceneObject, exclude, threshold);
		proposedX = snap.x;
		proposedY = snap.y;
		state.snapGuides = snap.guides;
	} else {
		state.snapGuides = [];
	}

	const snapDX = proposedX - (primaryStart.x + dx);
	const snapDY = proposedY - (primaryStart.y + dy);

	for (const [id, start] of it.startTransforms) {
		const obj = findObject(id);
		if (!obj) continue;
		obj.transform.x = round(start.x + dx + snapDX);
		obj.transform.y = round(start.y + dy + snapDY);
	}
}

function updateResize(worldX: number, worldY: number, shiftKey: boolean): void {
	if (!state.interaction || state.interaction.mode !== "resize") return;
	const it = state.interaction;
	if (!it.handle) return;
	const obj = findObject(it.primaryId);
	const start = it.startTransforms.get(it.primaryId);
	if (!obj || !start) return;

	const dx = worldX - it.startWorldX;
	const dy = worldY - it.startWorldY;
	const handle = it.handle;

	const isLeft = handle === "w" || handle === "nw" || handle === "sw";
	const isRight = handle === "e" || handle === "ne" || handle === "se";
	const isTop = handle === "n" || handle === "nw" || handle === "ne";
	const isBottom = handle === "s" || handle === "sw" || handle === "se";

	let newW = start.width;
	let newH = start.height;
	let newX = start.x;
	let newY = start.y;

	if (isRight) newW = Math.max(4, start.width + dx);
	if (isLeft) newW = Math.max(4, start.width - dx);
	if (isBottom) newH = Math.max(4, start.height + dy);
	if (isTop) newH = Math.max(4, start.height - dy);

	if (isLeft) newX = start.x + (start.width - newW) / 2;
	if (isRight) newX = start.x + (newW - start.width) / 2;
	if (isTop) newY = start.y + (start.height - newH) / 2;
	if (isBottom) newY = start.y + (newH - start.height) / 2;

	if (shiftKey && isLeft === isRight && isTop === isBottom) {
		const aspect = start.width / start.height;
		if (newW / newH > aspect) newW = newH * aspect;
		else newH = newW / aspect;
	}

	if (state.scene?.snapToGrid) {
		const gs = state.scene.gridSize || 32;
		newW = Math.round(newW / gs) * gs;
		newH = Math.round(newH / gs) * gs;
		newX = Math.round(newX / gs) * gs;
		newY = Math.round(newY / gs) * gs;
	}

	obj.transform.width = round(newW);
	obj.transform.height = round(newH);
	obj.transform.x = round(newX);
	obj.transform.y = round(newY);
}

function updateRotate(worldX: number, worldY: number, shiftKey: boolean, altKey: boolean): void {
	if (!state.interaction || state.interaction.mode !== "rotate") return;
	const it = state.interaction;
	if (!it.rotateCenter || it.rotateStartAngle === undefined || it.rotateStartRotation === undefined) return;
	const obj = findObject(it.primaryId);
	if (!obj) return;

	const currentAngle = Math.atan2(worldY - it.rotateCenter.y, worldX - it.rotateCenter.x);
	let deltaDeg = ((currentAngle - it.rotateStartAngle) * 180) / Math.PI;
	if (deltaDeg > 180) deltaDeg -= 360;
	if (deltaDeg < -180) deltaDeg += 360;

	let newRotation = it.rotateStartRotation + deltaDeg;
	if (altKey) newRotation = Math.round(newRotation / 90) * 90;
	else if (shiftKey) newRotation = Math.round(newRotation / 15) * 15;

	newRotation = ((newRotation % 360) + 360) % 360;
	obj.transform.rotation = round(newRotation * 100) / 100;
}

function endInteraction(): void {
	if (!state.interaction) return;
	if (state.interaction.mode !== "idle" && state.interaction.mode !== "pan") {
		snapshot();
	}
	state.interaction = null;
	state.snapGuides = [];
}

