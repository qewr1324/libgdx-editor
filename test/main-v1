		}
		ImGui.Separator();
		if (ImGui.MenuItem("Undo", "Ctrl+Z")) {
			undo();
			closed = true;
		}
		if (ImGui.MenuItem("Redo", "Ctrl+Y")) {
			redo();
			closed = true;
		}
		ImGui.Separator();
		if (ImGui.MenuItem("Reset View")) {
			state.camera = {
				x: state.scene!.worldSize.width / 2,
				y: state.scene!.worldSize.height / 2,
				zoom: 0.5,
			};
			closed = true;
		}
	}
	ImGui.End();
	ImGui.PopStyleColor(2);
	ImGui.PopStyleVar(3);

	if (closed) {
		state.contextMenu.open = false;
		return;
	}

	// Close menu when clicking outside the menu
	if (ImGui.IsMouseClicked(ImGuiMouseButton.Left) || ImGui.IsMouseClicked(ImGuiMouseButton.Right)) {
		const mx = ImGui.GetMousePos().x;
		const my = ImGui.GetMousePos().y;
		// Approximate menu bounds (auto-resize window, so use generous estimates)
		const menuW = 220;
		const menuH = 260;
		if (mx < state.contextMenu.x || mx > state.contextMenu.x + menuW || my < state.contextMenu.y || my > state.contextMenu.y + menuH) {
			state.contextMenu.open = false;
		}
	}
}

// =============================================================
// Scene management
// =============================================================

function newScene(): void {
	state.scene = {
		name: "Untitled",
		worldSize: { width: 1920, height: 1080 },
		backgroundColor: col(0xff1a1a1a),
		gridSize: 32,
		snapToGrid: false,
		snapToObjects: true,
		showGrid: true,
		showWorldBorder: true,
		showRulers: true,
		objects: [],
	};
	state.camera = { x: 960, y: 540, zoom: 0.6 };
	state.selectedIds = [];
	state.primaryId = null;
	state.history = [];
	state.historyIndex = -1;
	snapshot();

	const r1 = createObject("rectangle", 400, 300);
	const c1 = createObject("circle", 900, 400);
	const s1 = createObject("star", 1400, 600);
	state.scene.objects.push(r1, c1, s1);
}

function saveJSON(): void {
	if (!state.scene) return;
	const json = JSON.stringify(state.scene, null, 2);
	const blob = new Blob([json], { type: "application/json" });
	const url = URL.createObjectURL(blob);
	const a = document.createElement("a");
	a.href = url;
	a.download = `${state.scene.name || "scene"}.json`;
	a.click();
	URL.revokeObjectURL(url);
}

function loadJSON(): void {
	const input = document.createElement("input");
	input.type = "file";
	input.accept = "application/json";
	input.onchange = async () => {
		const file = input.files?.[0];
		if (!file) return;
		const text = await file.text();
		try {
			state.scene = JSON.parse(text);
			state.selectedIds = [];
			state.primaryId = null;
			state.history = [];
			state.historyIndex = -1;
			snapshot();
		} catch (e) {
			console.error(e);
		}
	};
	input.click();
}

// =============================================================
// Keyboard shortcuts
// =============================================================

function setupKeyboard(): void {
	window.addEventListener("keydown", (e) => {
		const tag = (e.target as HTMLElement)?.tagName;
		if (tag === "INPUT" || tag === "TEXTAREA") return;

		const mod = e.ctrlKey || e.metaKey;
		if (mod && e.key === "z" && !e.shiftKey) {
			e.preventDefault();
			undo();
		} else if (mod && (e.key === "y" || (e.key === "z" && e.shiftKey))) {
			e.preventDefault();
			redo();
		} else if (mod && e.key === "d") {
			e.preventDefault();
			duplicateSelected();
		} else if (e.key === "Delete" || e.key === "Backspace") {
			e.preventDefault();
			deleteSelected();
		} else if (e.key === "Escape") {
			state.selectedIds = [];
			state.primaryId = null;
			state.interaction = null;
			state.snapGuides = [];
			state.contextMenu.open = false;
		}
	});
}

// =============================================================
// Canvas resolution & DPI
// =============================================================

function setupCanvasResolution(canvas: HTMLCanvasElement): void {
	const applyDpr = () => {
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const w = Math.floor(canvas.clientWidth * dpr);
		const h = Math.floor(canvas.clientHeight * dpr);
		if (canvas.width !== w || canvas.height !== h) {
			canvas.width = w;
			canvas.height = h;
		}
	};

	window.addEventListener("resize", applyDpr);
	window.addEventListener("orientationchange", applyDpr);
	applyDpr();
}

// =============================================================
// Bootstrap
// =============================================================

const canvas = document.getElementById("canvas") as HTMLCanvasElement;
const loadingEl = document.getElementById("loading")!;

async function bootstrap(): Promise<void> {
	// Ensure canvas element fills the viewport before ImGui reads it
	canvas.style.width = "100vw";
	canvas.style.height = "100vh";
	canvas.style.display = "block";

	await ImGuiImplWeb.Init({
		canvas,
		backend: "webgl2",
		fontLoader: "truetype", // switch to "freetype" for sharper glyphs
	});

	setupCanvasResolution(canvas);

	// ---- Style: sharper rendering + better contrast ----
	const style = ImGui.GetStyle();
	ImGui.StyleColorsDark();

	style.WindowRounding = 0;
	style.ChildRounding = 4;
	style.FrameRounding = 3;
	style.GrabRounding = 3;
	style.ScrollbarRounding = 3;

	style.WindowBorderSize = 1;
	style.ChildBorderSize = 1;
	style.FrameBorderSize = 0;

	style.FramePadding = new ImVec2(8, 5);
	style.ItemSpacing = new ImVec2(8, 6);
	style.ItemInnerSpacing = new ImVec2(6, 4);

	// Anti-aliasing for nicer shapes & lines
	style.AntiAliasedLines = true;
	style.AntiAliasedLinesUseTex = true;
	style.AntiAliasedFill = true;
	style.CurveTessellationTol = 1.25;
	style.CircleTessellationMaxError = 0.3;

	// Font size base (used to scale with DPI on systems that support it)
	style.FontSizeBase = 15.0;

	// Higher-quality colors
	style.Colors[ImGuiCol.WindowBg] = new ImVec4(0.1, 0.1, 0.11, 1.0);
	style.Colors[ImGuiCol.ChildBg] = new ImVec4(0.11, 0.11, 0.12, 1.0);
	style.Colors[ImGuiCol.PopupBg] = new ImVec4(0.13, 0.13, 0.15, 1.0);
	style.Colors[ImGuiCol.Border] = new ImVec4(0.22, 0.22, 0.24, 1.0);
	style.Colors[ImGuiCol.FrameBg] = new ImVec4(0.17, 0.17, 0.19, 1.0);
	style.Colors[ImGuiCol.FrameBgHovered] = new ImVec4(0.22, 0.22, 0.25, 1.0);
	style.Colors[ImGuiCol.FrameBgActive] = new ImVec4(0.26, 0.26, 0.3, 1.0);
	style.Colors[ImGuiCol.Button] = new ImVec4(0.2, 0.2, 0.23, 1.0);
	style.Colors[ImGuiCol.ButtonHovered] = new ImVec4(0.28, 0.28, 0.32, 1.0);
	style.Colors[ImGuiCol.ButtonActive] = new ImVec4(0.35, 0.35, 0.4, 1.0);

	newScene();
	setupKeyboard();

	loadingEl.classList.add("hidden");
	requestAnimationFrame(renderLoop);
}

bootstrap().catch((err) => {
	console.error(err);
	loadingEl.textContent = `Error: ${err.message}`;
});
