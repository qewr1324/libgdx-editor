function duplicateSelected(): void {
	if (!state.scene || state.selectedIds.length === 0) return;
	const newIds: string[] = [];
	for (const id of state.selectedIds) {
		const obj = findObject(id);
		if (!obj) continue;
		const copy: SceneObject = JSON.parse(JSON.stringify(obj));
		copy.id = makeId();
		copy.name = obj.name + "_copy";
		copy.transform.x += 20;
		copy.transform.y += 20;
		state.scene.objects.push(copy);
		newIds.push(copy.id);
	}
	state.selectedIds = newIds;
	state.primaryId = newIds[newIds.length - 1] ?? null;
	snapshot();
}

function deleteSelected(): void {
	if (!state.scene || state.selectedIds.length === 0) return;
	state.scene.objects = state.scene.objects.filter((o) => !state.selectedIds.includes(o.id));
	state.selectedIds = [];
	state.primaryId = null;
	snapshot();
}

// =============================================================
// Main render loop
// =============================================================

function renderLoop(): void {
	ImGuiImplWeb.BeginRender();

	const vp = ImGui.GetMainViewport();
	ImGui.SetNextWindowPos(vp.WorkPos);
	ImGui.SetNextWindowSize(vp.WorkSize);

	const rootFlags = ImGuiWindowFlags.NoTitleBar | ImGuiWindowFlags.NoResize | ImGuiWindowFlags.NoMove | ImGuiWindowFlags.NoCollapse | ImGuiWindowFlags.NoBringToFrontOnFocus | ImGuiWindowFlags.NoScrollbar | ImGuiWindowFlags.NoScrollWithMouse | ImGuiWindowFlags.MenuBar;

	ImGui.PushStyleVar(ImGuiStyleVar.WindowRounding, 0);
	ImGui.PushStyleVar(ImGuiStyleVar.WindowBorderSize, 0);
	ImGui.PushStyleVarImVec2(ImGuiStyleVar.WindowPadding, new ImVec2(0, 0));

	ImGui.Begin("##Root", null, rootFlags);
	ImGui.PopStyleVar(3);

	if (ImGui.BeginMenuBar()) {
		if (ImGui.BeginMenu("File")) {
			if (ImGui.MenuItem("New Scene")) newScene();
			if (ImGui.MenuItem("Save JSON")) saveJSON();
			if (ImGui.MenuItem("Load JSON")) loadJSON();
			ImGui.EndMenu();
		}
		if (ImGui.BeginMenu("Edit")) {
			if (ImGui.MenuItem("Undo", "Ctrl+Z")) undo();
			if (ImGui.MenuItem("Redo", "Ctrl+Y")) redo();
			ImGui.Separator();
			if (ImGui.MenuItem("Duplicate", "Ctrl+D")) duplicateSelected();
			if (ImGui.MenuItem("Delete", "Del")) deleteSelected();
			ImGui.EndMenu();
		}
		if (ImGui.BeginMenu("Help")) {
			ImGui.MenuItem("Middle mouse or Space+drag to pan", null, false, false);
			ImGui.MenuItem("Wheel to zoom", null, false, false);
			ImGui.MenuItem("Left click to select, drag to move", null, false, false);
			ImGui.EndMenu();
		}
		ImGui.EndMenuBar();
	}

	const toolbarHeight = 36;
	ImGui.BeginChild("##toolbar", new ImVec2(0, toolbarHeight), ImGuiChildFlags.None);
	ImGui.PushStyleVarImVec2(ImGuiStyleVar.FramePadding, new ImVec2(8, 5));
	renderToolbar();
	ImGui.PopStyleVar();
	ImGui.EndChild();

	const statusHeight = 26;

	const avail = ImGui.GetContentRegionAvail();
	const vpW = avail.x;
	const vpH = avail.y - statusHeight;

	ImGui.BeginChild("##viewport", new ImVec2(vpW, vpH), ImGuiChildFlags.Borders);

	const vpScreenPos = ImGui.GetCursorScreenPos();
	const vpSize = ImGui.GetContentRegionAvail();

	const rulerPad = (state.scene?.showRulers ?? true) ? 24 : 0;

	const vpRect: ViewportRect = {
		x: vpScreenPos.x + rulerPad,
		y: vpScreenPos.y + rulerPad,
		w: vpSize.x - rulerPad,
		h: vpSize.y - rulerPad,
		originX: vpScreenPos.x + rulerPad,
		originY: vpScreenPos.y + rulerPad,
	};

	ImGui.InvisibleButton("##vp_canvas", new ImVec2(vpSize.x, vpSize.y), 0);

	const hovered = ImGui.IsItemHovered();
	const mouseScreen = ImGui.GetMousePos();
	const worldMouse = screenToWorld(mouseScreen.x, mouseScreen.y, vpRect.originX, vpRect.originY);

	if (hovered) {
		const wheel = ImGui.GetIO().MouseWheel;
		if (wheel !== 0) {
			const oldZoom = state.camera.zoom;
			const newZoom = Math.max(0.1, Math.min(8, oldZoom * (1 + wheel * 0.1)));
			state.camera.x += (worldMouse.x - state.camera.x) * (1 - oldZoom / newZoom);
			state.camera.y += (worldMouse.y - state.camera.y) * (1 - oldZoom / newZoom);
			state.camera.zoom = newZoom;
		}
	}

	const io = ImGui.GetIO();
	const spaceDown = ImGui.IsKeyDown(ImGuiKey._Space);
	const middleDown = ImGui.IsMouseDown(ImGuiMouseButton.Middle);
	const leftDown = ImGui.IsMouseDown(ImGuiMouseButton.Left);
	const panRequested = middleDown || (spaceDown && leftDown);

	if (panRequested && (hovered || state.interaction?.mode === "pan")) {
		if (!state.interaction || state.interaction.mode !== "pan") {
			state.interaction = {
				mode: "pan",
				startWorldX: worldMouse.x,
				startWorldY: worldMouse.y,
				startScreenX: mouseScreen.x,
				startScreenY: mouseScreen.y,
				startTransforms: new Map(),
				primaryId: "",
				panStartX: state.camera.x,
				panStartY: state.camera.y,
			};
		} else {
			const it = state.interaction;
			const ddx = (mouseScreen.x - it.startScreenX) / state.camera.zoom;
			const ddy = (mouseScreen.y - it.startScreenY) / state.camera.zoom;
			state.camera.x = it.panStartX! - ddx;
			state.camera.y = it.panStartY! - ddy;
		}
	} else if (state.interaction?.mode === "pan" && !panRequested) {
		state.interaction = null;
	}

	if (hovered && !panRequested) {
		const handleHit = findHandleAt(mouseScreen.x, mouseScreen.y, vpRect);
		const rotateHit = findRotateHandleAt(mouseScreen.x, mouseScreen.y, vpRect);
		const objHit = findObjectAt(worldMouse.x, worldMouse.y);

		if (handleHit) {
			const cursors: Record<HandleType, number> = {
				nw: ImGuiMouseCursor.ResizeNWSE,
				n: ImGuiMouseCursor.ResizeNS,
				ne: ImGuiMouseCursor.ResizeNESW,
				e: ImGuiMouseCursor.ResizeEW,
				se: ImGuiMouseCursor.ResizeNWSE,
				s: ImGuiMouseCursor.ResizeNS,
				sw: ImGuiMouseCursor.ResizeNESW,
				w: ImGuiMouseCursor.ResizeEW,
			};
			ImGui.SetMouseCursor(cursors[handleHit.handle]);
		} else if (rotateHit || objHit) {
			ImGui.SetMouseCursor(ImGuiMouseCursor.Hand);
		}

		if (ImGui.IsMouseClicked(ImGuiMouseButton.Left)) {
			if (handleHit) {
				beginResize(worldMouse.x, worldMouse.y, handleHit.obj, handleHit.handle);
			} else if (rotateHit) {
				beginRotate(worldMouse.x, worldMouse.y, rotateHit);
			} else if (objHit) {
				const isMulti = io.KeyShift || io.KeyCtrl || io.KeySuper;
				if (isMulti) {
					const idx = state.selectedIds.indexOf(objHit.id);
					if (idx >= 0) {
						state.selectedIds.splice(idx, 1);
						if (state.primaryId === objHit.id) {
							state.primaryId = state.selectedIds[state.selectedIds.length - 1] ?? null;
						}
					} else {
						state.selectedIds.push(objHit.id);
						state.primaryId = objHit.id;
					}
				} else {
					if (!state.selectedIds.includes(objHit.id)) {
						state.selectedIds = [objHit.id];
					}
					state.primaryId = objHit.id;
				}
				beginDrag(worldMouse.x, worldMouse.y, objHit.id);
			} else {
				state.selectedIds = [];
				state.primaryId = null;
			}
		}

		if (ImGui.IsMouseClicked(ImGuiMouseButton.Right)) {
			state.contextMenu.open = true;
			state.contextMenu.x = mouseScreen.x;
			state.contextMenu.y = mouseScreen.y;
			state.contextMenu.worldX = worldMouse.x;
			state.contextMenu.worldY = worldMouse.y;
		}
	}

	if (state.interaction) {
		if (state.interaction.mode === "drag") {
			updateDrag(worldMouse.x, worldMouse.y);
		} else if (state.interaction.mode === "resize") {
			updateResize(worldMouse.x, worldMouse.y, io.KeyShift);
		} else if (state.interaction.mode === "rotate") {
			updateRotate(worldMouse.x, worldMouse.y, io.KeyShift, io.KeyAlt);
		}
	}

	if (!ImGui.IsMouseDown(ImGuiMouseButton.Left) && state.interaction && state.interaction.mode !== "pan") {
		endInteraction();
	}

	renderViewport(vpRect);

	ImGui.EndChild();

	ImGui.BeginChild("##status", new ImVec2(0, statusHeight), ImGuiChildFlags.None);
	ImGui.Text(`Mouse: ${round(worldMouse.x)}, ${round(worldMouse.y)}`);
	ImGui.SameLine();
	ImGui.TextDisabled("|");
	ImGui.SameLine();
	ImGui.Text(`Zoom: ${(state.camera.zoom * 100).toFixed(0)}%`);
	ImGui.SameLine();
	ImGui.TextDisabled("|");
	ImGui.SameLine();
	ImGui.Text(`Objects: ${state.scene?.objects.length ?? 0}`);
	ImGui.SameLine();
	ImGui.TextDisabled("|");
	ImGui.SameLine();
	if (state.selectedIds.length === 1) {
		const o = findObject(state.selectedIds[0]);
		if (o) ImGui.Text(`Selected: ${o.name} (${round(o.transform.width)}x${round(o.transform.height)})`);
	} else if (state.selectedIds.length > 1) {
		ImGui.Text(`${state.selectedIds.length} selected`);
	} else {
		ImGui.TextDisabled("No selection");
	}
	ImGui.EndChild();

	ImGui.End();

	renderContextMenu();

	ImGuiImplWeb.EndRender();
	requestAnimationFrame(renderLoop);
}

