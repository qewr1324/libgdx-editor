{
	"name": "libgdx-editor",
	"type": "module",
	"displayName": "LibGDX Editor",
	"description": "❄️ LibGDX Editor - There is a 2D editor for game development in libGDX for 💠 VSCode. ",
	"version": "0.55.30",
	"private": false,
	"publisher": "GhurbeSABZI",
	"packageManager": "bun@1.3.14",
	"author": "GhurbeSABZI <naiad.arts.studio@gmail.com>",
	"icon": "res/libgdx-editor-icon-big.png",
	"license": "MIT",
	"homepage": "https://github.com/qewr1324/libgdx-editor#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/qewr1324/libgdx-editor"
	},
	"bugs": {
		"url": "https://github.com/qewr1324/libgdx-editor/issues"
	},
	"engines": {
		"vscode": "^1.90.0"
	},
	"keywords": [
		"editor",
		"viewport",
		"file",
		"libgdx",
		"libgdx editor",
		"libgdx viewport",
		"vscode extension",
		"developer tools"
	],
	"categories": [
		"Visualization",
		"Programming Languages",
		"Other"
	],
	"galleryBanner": {
		"color": "#0D1117",
		"theme": "dark"
	},
	"preview": false,
	"qna": "marketplace",
	"activationEvents": [
		"onCustomEditor:libgdx-editor.sceneEditor",
		"onView:libgdx-editor.inspector",
		"onView:libgdx-editor.layers",
		"onCommand:libgdx-editor.openEditor",
		"onCommand:libgdx-editor.newScene",
		"onCommand:libgdx-editor.importTexture",
		"onCommand:libgdx-editor.cleanupAssets"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"commands": [
			{
				"command": "libgdx-editor.openEditor",
				"title": "LibGDX: Open Scene Editor",
				"icon": "$(window)"
			},
			{
				"command": "libgdx-editor.newScene",
				"title": "LibGDX: New Scene",
				"icon": "$(new-file)"
			},
			{
				"command": "libgdx-editor.importTexture",
				"title": "LibGDX: Import Texture",
				"icon": "$(file-media)"
			},
			{
				"command": "libgdx-editor.cleanupAssets",
				"title": "LibGDX: Cleanup Unused Assets",
				"icon": "$(trash)"
			}
		],
		"customEditors": [
			{
				"viewType": "libgdx-editor.sceneEditor",
				"displayName": "LibGDX Scene Editor",
				"selector": [
					{
						"filenamePattern": "*.lgdx.json"
					}
				],
				"priority": "default"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "libgdx-editor",
					"title": "LibGDX Editor",
					"icon": "res/icon.svg"
				}
			]
		},
		"views": {
			"libgdx-editor": [
				{
					"id": "libgdx-editor.layers",
					"name": "Layers",
					"type": "webview"
				},
				{
					"id": "libgdx-editor.inspector",
					"name": "Inspector",
					"type": "webview"
				}
			]
		},
		"menus": {
			"commandPalette": [
				{
					"command": "libgdx-editor.newScene",
					"when": "true"
				},
				{
					"command": "libgdx-editor.importTexture",
					"when": "true"
				},
				{
					"command": "libgdx-editor.cleanupAssets",
					"when": "true"
				}
			],
			"explorer/context": [
				{
					"command": "libgdx-editor.newScene",
					"when": "explorerResourceIsFolder",
					"group": "navigation@10"
				},
				{
					"command": "libgdx-editor.importTexture",
					"when": "resourceExtname =~ /\\.(png|jpg|jpeg|gif|webp|bmp|svg)$/i",
					"group": "navigation@11"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run build",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"build": "tsdown",
		"dev": "bun run build --watch --sourcemap",
		"prepare": "echo 'Skipping update'",
		"update": "echo 'Skipping vscode-ext-gen'",
		"lint": "eslint .",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"ext:package": "vsce package --no-dependencies",
		"ext:publish": "vsce publish --no-dependencies"
	},
	"dependencies": {
		"pixi.js": "^8.6.6",
		"pixi-viewport": "^6.0.3"
	},
	"devDependencies": {
		"@types/vscode": "^1.90.0",
		"@types/node": "^20.0.0",
		"typescript": "^5.3.0",
		"@antfu/eslint-config": "^6.7.3",
		"@antfu/ni": "^28.0.0",
		"@vscode/vsce": "^3.7.1",
		"bumpp": "^10.3.2",
		"eslint": "^9.39.2",
		"ovsx": "^0.10.7",
		"reactive-vscode": "^1.0.0-beta.2",
		"taze": "^19.9.2",
		"tsdown": "^0.19.0-beta.3",
		"vite": "^7.3.0",
		"vitest": "^4.0.16",
		"vscode-ext-gen": "^1.5.1",
		"vsxpub": "^0.1.2"
	}
}